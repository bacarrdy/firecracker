+        ring.submit_and_wait_all().unwrap();
+        let cqe = ring.pop().unwrap().unwrap();
+        assert_eq!(cqe.result().unwrap_err().raw_os_error(), Some(libc::EBADF));
+        assert_eq!(cqe.count(), 0);
+        assert_eq!(cqe.user_data(), 42);
+    }
+
     #[test]
     fn test_user_data() {
