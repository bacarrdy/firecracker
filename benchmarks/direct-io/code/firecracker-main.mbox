From c4597fe4e1e75f7577f4163a04a3ee0b1ce893f3 Mon Sep 17 00:00:00 2001
From: Jonas Savulionis <jonas@esnet.lt>
Date: Sat, 21 Nov 2026 20:45:53 +0200
Subject: [PATCH 3/6] fix(io_uring): decode negative completion errors as
 positive errno

Linux reports a failed operation as -errno in the CQE. Convert it to
the positive OS error code expected by Rust, falling back to EIO if its
magnitude cannot be represented. Test the raw OS error, ErrorKind, and
an actual write on a read-only registered file.

Signed-off-by: Jonas Savulionis <jonas@esnet.lt>
---
 src/vmm/src/io_uring/operation/cqe.rs | 34 ++++++++++++++++++++++-----
 1 file changed, 28 insertions(+), 6 deletions(-)

diff --git a/src/vmm/src/io_uring/operation/cqe.rs b/src/vmm/src/io_uring/operation/cqe.rs
index bd445ecb2..5658aaf8f 100644
--- a/src/vmm/src/io_uring/operation/cqe.rs
+++ b/src/vmm/src/io_uring/operation/cqe.rs
@@ -32,7 +32,9 @@ impl<T: Debug> Cqe<T> {
         let res = self.res;
 
         if res < 0 {
-            Err(std::io::Error::from_raw_os_error(res))
+            Err(std::io::Error::from_raw_os_error(
+                res.checked_neg().unwrap_or(libc::EIO),
+            ))
         } else {
             Ok(u32::try_from(self.res).unwrap())
         }
@@ -61,12 +63,11 @@ mod tests {
         // Check that `result()` returns an `Error` when `res` is negative.
         {
             let user_data = 10_u8;
-            let cqe: Cqe<u8> = Cqe::new(-22, user_data);
+            let cqe = Cqe::new(-libc::EINVAL, user_data);
 
-            assert_eq!(
-                cqe.result().unwrap_err().kind(),
-                std::io::Error::from_raw_os_error(-22).kind()
-            );
+            let err = cqe.result().unwrap_err();
+            assert_eq!(err.raw_os_error(), Some(libc::EINVAL));
+            assert_eq!(err.kind(), std::io::ErrorKind::InvalidInput);
         }
 
         // Check that `result()` returns Ok() when `res` is positive.
@@ -78,6 +79,27 @@ mod tests {
         }
     }
 
+    #[test]
+    fn test_errno_outside_i32_range() {
+        let err = Cqe::new(i32::MIN, ()).result().unwrap_err();
+        assert_eq!(err.raw_os_error(), Some(libc::EIO));
+    }
+
+    #[test]
+    fn test_kernel_write_to_read_only_fd_errno() {
+        use crate::io_uring::{IoUring, Operation};
+
+        let file = std::fs::File::open("/dev/null").unwrap();
+        let mut ring = IoUring::new(2, vec![&file], vec![], None).unwrap();
+        ring.push(Operation::write(0, b"x".as_ptr() as usize, 1, 0, 42u8))
