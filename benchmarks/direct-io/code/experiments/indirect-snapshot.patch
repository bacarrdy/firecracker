-/// Snapshot version: the newest format this build reads and writes.
-///
-/// 12.1 is 12.0 plus one meaning: a virtio block device which offers
-/// `VIRTIO_BLK_F_SEG_MAX` (several data descriptors per request). The state layout is the same.
-/// A snapshot is written as 12.1 only when such a device is in it (see
-/// [`snapshot_version_for`]), so a VMM that knows only 12.0 (one data descriptor per request)
-/// refuses exactly the snapshots it would misread, and still loads every other one.
-pub const SNAPSHOT_VERSION: Version = Version::new(12, 1, 0);
-
-/// The format of a snapshot without a multi-segment block device: readable by 12.0 VMMs.
+/// Latest snapshot format accepted by this build.
+#[cfg(feature = "block-indirect-experiment")]
+pub const SNAPSHOT_VERSION: Version = SNAPSHOT_VERSION_INDIRECT_BLOCK;
+/// Latest snapshot format accepted by this build.
+#[cfg(not(feature = "block-indirect-experiment"))]
+pub const SNAPSHOT_VERSION: Version = SNAPSHOT_VERSION_MULTI_SEGMENT_BLOCK;
+
+/// Original format, before block devices offered SEG_MAX.
 pub const SNAPSHOT_VERSION_SINGLE_SEGMENT_BLOCK: Version = Version::new(12, 0, 0);
+/// Same layout as 12.0, with the SG32 block configuration contract.
+const SNAPSHOT_VERSION_MULTI_SEGMENT_BLOCK: Version = Version::new(12, 1, 0);
+/// Same layout as 12.1, with split indirect descriptors offered by a native block device.
+const SNAPSHOT_VERSION_INDIRECT_BLOCK: Version = Version::new(12, 2, 0);
+
+fn native_block_states(
+    state: &MicrovmState,
+) -> impl Iterator<Item = &crate::devices::virtio::block::virtio::persist::VirtioBlockState> {
+    use crate::devices::virtio::block::persist::BlockState;
 
-/// The format version to write `state` with: 12.1 if a virtio block device offers
-/// `VIRTIO_BLK_F_SEG_MAX`, 12.0 otherwise.
+    let (mmio, pci) = match &state.device_states.virtio_state {
+        VirtioDevicesState::Mmio(mmio) => (mmio.block_devices.as_slice(), &[][..]),
+        VirtioDevicesState::Pci(pci) => (&[][..], pci.block_devices.as_slice()),
+    };
+    mmio.iter()
+        .map(|device| &device.device_state)
+        .chain(pci.iter().map(|device| &device.device_state))
+        .filter_map(|device| match device {
+            BlockState::Virtio(block) => Some(block),
+            BlockState::VhostUser(_) => None,
+        })
+}
+
+/// Select the oldest format that represents the block features offered in this state.
+/// The guest can negotiate an offered feature after restore, so ACK is not decisive.
 pub fn snapshot_version_for(state: &MicrovmState) -> Version {
-    use crate::devices::virtio::block::persist::BlockState;
     use crate::devices::virtio::generated::virtio_blk::VIRTIO_BLK_F_SEG_MAX;
 
-    let multi_segment = |block: &BlockState| match block {
-        BlockState::Virtio(block) => {
-            block.virtio_state.avail_features & (1u64 << VIRTIO_BLK_F_SEG_MAX) != 0
+    let mut version = SNAPSHOT_VERSION_SINGLE_SEGMENT_BLOCK;
+    for block in native_block_states(state) {
+        if block.offers_indirect() {
+            return SNAPSHOT_VERSION_INDIRECT_BLOCK;
+        }
+        if block.virtio_state.avail_features & (1u64 << VIRTIO_BLK_F_SEG_MAX) != 0 {
+            version = SNAPSHOT_VERSION_MULTI_SEGMENT_BLOCK;
         }
-        BlockState::VhostUser(_) => false,
-    };
-    let any = match &state.device_states.virtio_state {
-        VirtioDevicesState::Mmio(mmio) => mmio
-            .block_devices
-            .iter()
-            .any(|d| multi_segment(&d.device_state)),
-        VirtioDevicesState::Pci(pci) => pci
-            .block_devices
-            .iter()
-            .any(|d| multi_segment(&d.device_state)),
-    };
-    if any {
-        SNAPSHOT_VERSION
-    } else {
-        SNAPSHOT_VERSION_SINGLE_SEGMENT_BLOCK
     }
+    version
 }
 
 /// Creates a Microvm snapshot.
@@ -623,18 +631,41 @@ pub enum SnapshotStateFromFileError {
     Open(#[from] std::io::Error),
     /// Failed to load snapshot state from file: {0}
     Load(#[from] crate::snapshot::SnapshotError),
+    /// Snapshot version {0} does not match the offered block indirect feature
+    BlockIndirectVersion(Version),
+    /// Invalid block indirect state: {0}
+    BlockIndirectState(crate::devices::virtio::block::virtio::VirtioBlockError),
     /// Unknown Network Device.
     UnknownNetworkDevice,
     /// Unknown Vsock Device.
     UnknownVsockDevice,
 }
 
+fn validate_block_indirect_state(
+    snapshot: &Snapshot<MicrovmState>,
+) -> Result<(), SnapshotStateFromFileError> {
+    let indirect_version = snapshot.version().minor == SNAPSHOT_VERSION_INDIRECT_BLOCK.minor;
+    let offers_indirect = native_block_states(&snapshot.data).any(|block| block.offers_indirect());
+    if indirect_version != offers_indirect {
+        return Err(SnapshotStateFromFileError::BlockIndirectVersion(
+            snapshot.version().clone(),
+        ));
+    }
+
+    for block in native_block_states(&snapshot.data) {
+        block
+            .validate_indirect()
+            .map_err(SnapshotStateFromFileError::BlockIndirectState)?;
+    }
+    Ok(())
+}
+
 fn snapshot_state_from_file(
     snapshot_path: &Path,
 ) -> Result<MicrovmState, SnapshotStateFromFileError> {
     let mut snapshot_reader = File::open(snapshot_path)?;
     let snapshot = Snapshot::load(&mut snapshot_reader)?;
-
+    validate_block_indirect_state(&snapshot)?;
     Ok(snapshot.data)
 }
 
