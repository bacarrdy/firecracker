+    #[test]
+    fn test_snapshot_indirect_feature_contract() {
+        use crate::devices::virtio::block::persist::BlockState;
+        use crate::devices::virtio::block::virtio::{INDIRECT_FEATURE, VirtioBlockError};
+
+        let mut vmm = default_vmm();
+        let mut event_manager = EventManager::new().unwrap();
+        insert_block_devices(
+            &mut vmm,
+            &mut default_kernel_cmdline(),
+            &mut event_manager,
+            vec![CustomBlockConfig::new(
+                "root".into(),
+                true,
+                None,
+                true,
+                CacheType::Unsafe,
+            )],
+        );
+        let mut state = vmm.save_state(&VmInfo::default()).unwrap();
+        let VirtioDevicesState::Mmio(mmio) = &mut state.device_states.virtio_state else {
+            unreachable!()
+        };
+        let BlockState::Virtio(block) = &mut mmio.block_devices[0].device_state else {
+            unreachable!()
+        };
+        let saved_features = &mut block.virtio_state;
+        saved_features.acked_features |= INDIRECT_FEATURE;
+        assert!(matches!(
+            block.validate_indirect(),
+            Err(VirtioBlockError::IndirectNotOffered(_))
+        ));
+        block.virtio_state.acked_features &= !INDIRECT_FEATURE;
+        block.virtio_state.avail_features |= INDIRECT_FEATURE;
+
+        assert_eq!(
+            snapshot_version_for(&state),
+            SNAPSHOT_VERSION_INDIRECT_BLOCK
+        );
+        let old_header = Snapshot::new_with_version(state, SNAPSHOT_VERSION_MULTI_SEGMENT_BLOCK);
+        assert!(matches!(
+            validate_block_indirect_state(&old_header),
+            Err(SnapshotStateFromFileError::BlockIndirectVersion(_))
+        ));
+        let new_header =
+            Snapshot::new_with_version(MicrovmState::default(), SNAPSHOT_VERSION_INDIRECT_BLOCK);
+        assert!(matches!(
+            validate_block_indirect_state(&new_header),
+            Err(SnapshotStateFromFileError::BlockIndirectVersion(_))
+        ));
+    }
+
