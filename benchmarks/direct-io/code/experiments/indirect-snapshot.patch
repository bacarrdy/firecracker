+++ b/src/vmm/src/devices/virtio/block/virtio/persist.rs
@@ -70,6 +70,31 @@ pub struct VirtioBlockState {
     discard_sector_alignment: u32,
 }
 
+impl VirtioBlockState {
+    pub(crate) fn offers_indirect(&self) -> bool {
+        self.virtio_state.avail_features & INDIRECT_FEATURE != 0
+    }
+
+    pub(crate) fn validate_indirect(&self) -> Result<(), VirtioBlockError> {
+        if !self.offers_indirect() {
+            if self.virtio_state.acked_features & INDIRECT_FEATURE != 0 {
+                return Err(VirtioBlockError::IndirectNotOffered(self.id.clone()));
+            }
+            return Ok(());
+        }
+
+        if self.virtio_state.avail_features & (1u64 << VIRTIO_BLK_F_SEG_MAX) == 0 {
+            return Err(VirtioBlockError::IndirectWithoutSegMax(self.id.clone()));
+        }
+
+        #[cfg(feature = "block-indirect-experiment")]
+        if experimental_indirect_drive() == Some(std::ffi::OsStr::new(&self.id)) {
+            return Ok(());
+        }
+        Err(VirtioBlockError::IndirectRestoreDisabled(self.id.clone()))
+    }
+}
+
 impl Persist<'_> for VirtioBlock {
     type State = VirtioBlockState;
     type ConstructorArgs = BlockConstructorArgs;
@@ -97,6 +122,8 @@ impl Persist<'_> for VirtioBlock {
         constructor_args: Self::ConstructorArgs,
         state: &Self::State,
     ) -> Result<Self, Self::Error> {
+        state.validate_indirect()?;
+
         let is_read_only = state.virtio_state.avail_features & (1u64 << VIRTIO_BLK_F_RO) != 0;
         let discard = state.virtio_state.avail_features & (1u64 << VIRTIO_BLK_F_DISCARD) != 0;
         let rate_limiter = RateLimiter::restore((), &state.rate_limiter_state)
