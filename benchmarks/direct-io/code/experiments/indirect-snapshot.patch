-pub(super) const INDIRECT_FEATURE: u64 = 1 << 28;
+pub(crate) const INDIRECT_FEATURE: u64 = 1 << 28;
 
-/// Select one block drive for the fresh-boot-only experiment. The environment is
+/// Select one block drive for the private indirect-descriptor experiment. The environment is
 /// set before the process starts and this selection is immutable for its lifetime.
 #[cfg(feature = "block-indirect-experiment")]
 pub(crate) fn experimental_indirect_drive() -> Option<&'static std::ffi::OsStr> {
@@ -46,7 +46,7 @@ pub const MAX_DISCARD_SECTORS: u32 = (128_u32 << 20) / SECTOR_SIZE;
 /// This is part of the 12.1 snapshot contract; changing it requires a new
 /// serialized contract and compatibility handling for existing snapshots.
 ///
-/// The device has no indirect descriptors, so a request of N segments takes N + 2 descriptors of
+/// In the default direct-descriptor mode, N data segments take N + 2 descriptors of
 /// the 256-entry ring. 32 lets a guest build 128 KiB requests out of scattered 4 KiB pages;
 /// seven such 34-descriptor requests fit the ring at once. 32 is also the value of the
 /// upstream prototype and of other forks, so a guest that negotiated it with this build stays
@@ -95,6 +95,12 @@ pub enum VirtioBlockError {
     Interrupt(std::io::Error),
     /// Error coming from the rate limiter: {0}
     RateLimiter(std::io::Error),
+    /// Block drive {0} acknowledges indirect descriptors that it did not offer
+    IndirectNotOffered(String),
+    /// Block drive {0} offers indirect descriptors without the SG32 contract
+    IndirectWithoutSegMax(String),
+    /// Block drive {0} requires a destination with indirect descriptors enabled for that drive
+    IndirectRestoreDisabled(String),
     /// Persistence error: {0}
     Persist(crate::devices::virtio::persist::PersistError),
 }
diff --git a/src/vmm/src/devices/virtio/block/virtio/persist.rs b/src/vmm/src/devices/virtio/block/virtio/persist.rs
index 9c53d4eaf..ceb39eb64 100644
