+
+#[cfg(feature = "sg64-q512-experiment")]
+#[test]
+fn q512_block_completes_high_heads_across_index_wrap() {
+    let mem = single_region_mem(4 << 20);
+    let mut guest = Guest::with_size(&mem, 512);
+    let f = backing(1 << 20, 0x5c);
+    let mut block = make_block(
+        f.as_path().to_str().unwrap(),
+        FileEngineType::Async,
+        false,
+        &mem,
+        &guest.vq,
+    );
+    assert_eq!(super::BLOCK_QUEUE_SIZES, [512]);
+
+    // Start with head 511. Both rings turn over from slot 511 to slot zero
+    // and their 16-bit producer and consumer indices wrap in these two reads.
+    guest.free_desc = (0..512).collect();
+    guest.avail = u16::MAX;
+    guest.used_seen = u16::MAX;
+    guest.vq.avail.idx.set(u16::MAX);
+    guest.vq.used.idx.set(u16::MAX);
+    block.queues[0].next_avail.0 = u16::MAX;
+    block.queues[0].next_used.0 = u16::MAX;
+
+    let segs: Vec<_> = (0..64).map(|i| (DATA_BASE + i * 8192, 4096)).collect();
+    assert!(guest.submit_segs(0, Kind::Read, 0, 64 * 4096, &segs));
+    guest.submit(1, Kind::Read, 0, 4096, DATA_BASE + (1 << 20));
+    assert_eq!(guest.vq.avail.ring[511].get(), 511);
+    assert_eq!(guest.vq.avail.ring[0].get(), 445);
+    guest.kick(&mut block);
+    let mut used = wait_used(&mut block, &mut guest, 2);
+    used.sort_unstable();
+    assert_eq!(used, [(0, 64 * 4096 + 1), (1, 4097)]);
+    ok(&guest, &[0, 1]);
+    assert_eq!(guest.used_seen, 1);
+    for (addr, _) in segs.into_iter().chain([(DATA_BASE + (1 << 20), 4096)]) {
+        let mut bytes = [0; 4096];
+        mem.read_slice(&mut bytes, GuestAddress(addr)).unwrap();
+        assert_eq!(bytes, [0x5c; 4096]);
+    }
+}
+
+#[cfg(feature = "sg64-q512-experiment")]
+#[test]
+fn q512_queue_geometry_and_index_limits() {
+    use crate::devices::virtio::queue::QueueError;
+
+    let mem = single_region_mem(0x10000);
+    let vq = VirtQueue::new(GuestAddress(0), &mem, 512);
+    let mut q = vq.create_queue();
+    assert_eq!(vq.avail_start().0, 8192);
+    assert_eq!(vq.used_start().0, 9224);
+    assert!(matches!(
+        q.add_used(512, 0),
+        Err(QueueError::DescIndexOutOfBounds(512))
+    ));
+    assert!(q.add_used(511, 0).is_ok());
+    vq.avail.ring[0].set(512);
+    vq.avail.idx.set(1);
+    assert!(q.pop().unwrap().is_none());
+    for size in [0, 511, 513, 1024] {
+        q.size = size;
+        assert!(matches!(q.initialize(&mem), Err(QueueError::InvalidSize(n)) if n == size));
+    }
+    q.size = 512;
+    q.used_ring_address = GuestAddress(0x10000 - 4096);
+    assert!(matches!(
+        q.initialize(&mem),
+        Err(QueueError::MemoryError(_))
+    ));
+}
