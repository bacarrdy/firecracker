+    pub(crate) fn register_completion(
+        &mut self,
+        watch: Events,
+        ops: &mut EventOps,
+    ) -> event_manager::Result<()> {
+        match ops.add(watch) {
+            Ok(()) => self.completion_watch = Some(watch),
+            Err(event_manager::Error::FdAlreadyRegistered)
+                if self.completion_watch == Some(watch) => {}
+            Err(err) => return Err(err),
+        }
+        Ok(())
+    }
