+    #[test]
+    fn test_registered_completion_survives_replacement_and_rollback() {
+        let mut event_manager = EventManager::new().unwrap();
+        let mut block = default_block(FileEngineType::Async);
+        let mem = default_mem();
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        set_queue(&mut block, 0, vq.create_queue());
+        read_blk_req_descriptors(&vq);
+        vq.dtable[0].len.set(16);
+        vq.dtable[1].flags.set(VIRTQ_DESC_F_NEXT);
+        vq.dtable[1].len.set(512);
+        vq.dtable[2].len.set(1);
+        let header = GuestAddress(vq.dtable[0].addr.get());
+        mem.write_obj::<u32>(VIRTIO_BLK_T_OUT, header).unwrap();
+        let data = GuestAddress(vq.dtable[1].addr.get());
+        mem.write_obj::<u64>(0x1234, data).unwrap();
+
+        let replacement = vmm_sys_util::tempfile::TempFile::new().unwrap();
+        replacement.as_file().set_len(4096).unwrap();
+        let path = replacement.as_path().to_str().unwrap().to_owned();
+        let completion = |block: &VirtioBlock| {
+            let FileEngine::Async(engine) = &block.disk.file_engine else {
+                unreachable!()
+            };
+            (engine.completion_fd(), engine.uses_ring_fd())
+        };
+
+        // An API update after activate() but before the activation callback must
+        // leave registration to that callback.
+        let block = Arc::new(Mutex::new(block));
+        let subscriber = event_manager.add_subscriber(block.clone());
+        let before = completion(&block.lock().unwrap());
+        block
+            .lock()
+            .unwrap()
+            .activate(mem.clone(), default_interrupt())
+            .unwrap();
+        block
+            .lock()
+            .unwrap()
+            .update_disk_image_with_event_ops(
+                path.clone(),
+                Some(&mut event_manager.event_ops(subscriber).unwrap()),
+            )
+            .unwrap();
+        let first = completion(&block.lock().unwrap());
+        assert_eq!(before.0 != first.0, first.1);
+        event_manager.run_with_timeout(100).unwrap();
+
+        if first.1 {
+            // Force an EPOLL_CTL_DEL failure after adding the new, valid ring.
+            let mut ops = event_manager.event_ops(subscriber).unwrap();
+            let old_watch =
+                Events::with_data_raw(first.0, VirtioBlock::PROCESS_ASYNC_COMPLETION, EventSet::IN);
+            ops.remove(old_watch).unwrap();
+            let err = block
+                .lock()
+                .unwrap()
+                .update_disk_image_with_event_ops(path.clone(), Some(&mut ops))
+                .unwrap_err();
+            assert!(err.to_string().contains("completion ring registered"), "{err}");
+            assert_eq!(completion(&block.lock().unwrap()), first);
+            ops.add(old_watch).unwrap();
+        }
+
+        let final_disk = vmm_sys_util::tempfile::TempFile::new().unwrap();
+        final_disk.as_file().set_len(4096).unwrap();
+        let path = final_disk.as_path().to_str().unwrap().to_owned();
+        block
+            .lock()
+            .unwrap()
+            .update_disk_image_with_event_ops(
+                path,
+                Some(&mut event_manager.event_ops(subscriber).unwrap()),
+            )
+            .unwrap();
+        let last = completion(&block.lock().unwrap());
+        assert_eq!(first.0 != last.0, first.1);
+
+        block.lock().unwrap().queue_evts[0].write(1).unwrap();
+        for _ in 0..20 {
+            event_manager.run_with_timeout(100).unwrap();
+            if vq.used.idx.get() != 0 {
+                break;
+            }
+        }
+        assert_eq!(vq.used.idx.get(), 1);
+        let mut bytes = [0u8; 8];
+        std::os::unix::fs::FileExt::read_exact_at(final_disk.as_file(), &mut bytes, 0).unwrap();
+        assert_eq!(u64::from_le_bytes(bytes), 0x1234);
+        std::os::unix::fs::FileExt::read_exact_at(replacement.as_file(), &mut bytes, 0).unwrap();
+        assert_eq!(bytes, [0; 8]);
+    }
+
