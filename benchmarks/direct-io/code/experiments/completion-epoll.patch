+    pub(crate) fn acknowledge_completion(&self, active: bool) -> Result<(), AsyncIoError> {
+        match &self.completion_evt {
+            Some(event) => event.read().map(|_| ()).map_err(AsyncIoError::EventFd),
+            None if active => self
+                .ring
+                .refresh_completions()
+                .map_err(AsyncIoError::IoUring),
+            None => Ok(()),
+        }
+    }
