From fb05cd7fa0de260943183af6cdc9e28fb7e8287b Mon Sep 17 00:00:00 2001
From: Jonas Savulionis <jonas@esnet.lt>
Date: Sat, 21 Nov 2026 11:42:48 +0200
Subject: [PATCH 2/2] virtio-blk: build a clipped iovec window in one
 allocation

Signed-off-by: Jonas Savulionis <jonas@esnet.lt>
---
 src/vmm/src/devices/virtio/block/virtio/io/mod.rs | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/src/vmm/src/devices/virtio/block/virtio/io/mod.rs b/src/vmm/src/devices/virtio/block/virtio/io/mod.rs
index f81521289..e102c154e 100644
--- a/src/vmm/src/devices/virtio/block/virtio/io/mod.rs
+++ b/src/vmm/src/devices/virtio/block/virtio/io/mod.rs
@@ -40,11 +40,8 @@ fn io_window<'a>(
         }
         if iov.iov_len > available {
             scratch.clear();
-            scratch.extend_from_slice(&iovecs[..index]);
-            scratch.push(libc::iovec {
-                iov_base: iov.iov_base,
-                iov_len: available,
-            });
+            scratch.extend_from_slice(&iovecs[..=index]);
+            scratch[index].iov_len = available;
             return (scratch, limit);
         }
         bytes += iov.iov_len;
