diff --git a/src/vmm/src/devices/virtio/block/virtio/io/mod.rs b/src/vmm/src/devices/virtio/block/virtio/io/mod.rs
index 9089af7b8..f81521289 100644
--- a/src/vmm/src/devices/virtio/block/virtio/io/mod.rs
+++ b/src/vmm/src/devices/virtio/block/virtio/io/mod.rs
@@ -24,33 +24,32 @@ use crate::vstate::memory::{GuestAddress, GuestMemoryMmap};
 const MAX_IO_BYTES: usize = 0x7fff_0000;
 const MAX_IOVECS: usize = 1024;
 
-/// Make a bounded host operation from the remaining raw guest-memory ranges.
-fn io_window(iovecs: &[libc::iovec], window: &mut Vec<libc::iovec>) -> usize {
-    io_window_with_limit(iovecs, window, MAX_IO_BYTES)
-}
-
-fn io_window_with_limit(
-    iovecs: &[libc::iovec],
-    window: &mut Vec<libc::iovec>,
+/// Borrow the complete iovecs that fit in one host I/O. A cut in the middle of a
+/// segment needs a shortened final iovec, so only that case uses scratch storage.
+fn io_window<'a>(
+    iovecs: &'a [libc::iovec],
+    scratch: &'a mut Vec<libc::iovec>,
     limit: usize,
-) -> usize {
-    window.clear();
+) -> (&'a [libc::iovec], usize) {
+    let iovecs = &iovecs[..iovecs.len().min(MAX_IOVECS)];
     let mut bytes = 0;
-    for iov in iovecs.iter().take(MAX_IOVECS) {
-        let len = iov.iov_len.min(limit - bytes);
-        if len == 0 {
-            break;
+    for (index, iov) in iovecs.iter().enumerate() {
+        let available = limit - bytes;
+        if available == 0 || iov.iov_len == 0 {
+            return (&iovecs[..index], bytes);
         }
-        window.push(libc::iovec {
-            iov_base: iov.iov_base,
-            iov_len: len,
-        });
-        bytes += len;
-        if bytes == limit {
-            break;
+        if iov.iov_len > available {
+            scratch.clear();
+            scratch.extend_from_slice(&iovecs[..index]);
+            scratch.push(libc::iovec {
+                iov_base: iov.iov_base,
+                iov_len: available,
+            });
+            return (scratch, limit);
         }
+        bytes += iov.iov_len;
     }
-    bytes
+    (iovecs, bytes)
 }
 
 /// The host iovecs of a request's data segments. Fails if a segment is not inside guest memory
@@ -772,6 +771,40 @@ pub mod tests {
         assert!(!D4K.eligible_iovecs(&[iov(0x1000, 0)], 0));
     }
 
+    #[test]
+    fn test_whole_iovecs_are_borrowed_and_only_split_lengths_are_copied() {
+        let entry = |len| libc::iovec {
+            iov_base: std::ptr::null_mut(),
+            iov_len: len,
+        };
+        let spans = [entry(16), entry(64), entry(8)];
+        let mut scratch = Vec::new();
+        for (limit, expected_count, expected_bytes) in [(0, 0, 0), (16, 1, 16), (88, 3, 88)] {
+            let (window, bytes) = io_window(&spans, &mut scratch, limit);
+            assert_eq!(
+                (window.as_ptr(), window.len(), bytes),
+                (spans.as_ptr(), expected_count, expected_bytes)
+            );
+        }
+        assert_eq!(scratch.capacity(), 0);
+        let (window, bytes) = io_window(&spans, &mut scratch, 32);
+        assert_eq!((window.len(), window[1].iov_len, bytes), (2, 16, 32));
+        assert_ne!(window.as_ptr(), spans.as_ptr());
+        assert_eq!(spans[1].iov_len, 64);
+        let many = vec![entry(1); MAX_IOVECS + 1];
+        let (window, bytes) = io_window(&many, &mut scratch, MAX_IO_BYTES);
+        assert_eq!(
+            (window.as_ptr(), window.len(), bytes),
+            (many.as_ptr(), MAX_IOVECS, MAX_IOVECS)
+        );
+        let with_zero = [entry(1), entry(0), entry(1)];
+        let (window, bytes) = io_window(&with_zero, &mut scratch, MAX_IO_BYTES);
+        assert_eq!(
+            (window.as_ptr(), window.len(), bytes),
+            (with_zero.as_ptr(), 1, 1)
+        );
+    }
