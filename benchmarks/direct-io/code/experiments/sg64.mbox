From 5e7dfa67c28e1ce06a6e13bafb3cee9534aa5da4 Mon Sep 17 00:00:00 2001
From: Jonas Savulionis <jonas@esnet.lt>
Date: Sat, 21 Nov 2026 17:44:39 +0200
Subject: [PATCH] virtio-blk: add a boot-only SG64 experiment

Offer 64 segments when the explicit experiment build feature is selected. Keep the existing 32-segment snapshot interpretation and reject snapshot and pre-copy operations in the experimental Firecracker API. Snapshot version 12.1 has no numeric segment limit to distinguish the two contracts.

Signed-off-by: Jonas Savulionis <jonas@esnet.lt>
---
 src/firecracker/Cargo.toml                    |  1 +
 src/vmm/Cargo.toml                            |  1 +
 .../src/devices/virtio/block/virtio/device.rs |  8 +++---
 .../src/devices/virtio/block/virtio/mod.rs    |  7 ++++++
 src/vmm/src/rpc_interface.rs                  | 25 +++++++++++++++++++
 5 files changed, 38 insertions(+), 4 deletions(-)

diff --git a/src/firecracker/Cargo.toml b/src/firecracker/Cargo.toml
index 67c84c70b..30eaf0f11 100644
--- a/src/firecracker/Cargo.toml
+++ b/src/firecracker/Cargo.toml
@@ -19,6 +19,7 @@ bench = false
 tracing = ["log-instrument", "utils/tracing", "vmm/tracing"]
 fuzzing = ["vmm/fuzzing"]
 gdb = ["vmm/gdb"]
+sg64-experiment = ["vmm/sg64-experiment"]
 
 [dependencies]
 displaydoc = "0.2.6"
diff --git a/src/vmm/Cargo.toml b/src/vmm/Cargo.toml
index 36861e006..528f81d0d 100644
--- a/src/vmm/Cargo.toml
+++ b/src/vmm/Cargo.toml
@@ -13,6 +13,7 @@ default = []
 tracing = ["log-instrument"]
 gdb = ["gdbstub", "gdbstub_arch"]
 fuzzing = []
+sg64-experiment = []
 
 [dependencies]
 
diff --git a/src/vmm/src/devices/virtio/block/virtio/device.rs b/src/vmm/src/devices/virtio/block/virtio/device.rs
index f25e87e86..399bd7370 100644
--- a/src/vmm/src/devices/virtio/block/virtio/device.rs
+++ b/src/vmm/src/devices/virtio/block/virtio/device.rs
@@ -27,8 +27,8 @@ use vmm_sys_util::eventfd::EventFd;
 use super::io::async_io;
 use super::request::*;
 use super::{
-    BLOCK_QUEUE_SIZES, MAX_DISCARD_SECTORS, SECTOR_SHIFT, SECTOR_SIZE, SEG_MAX, VirtioBlockError,
-    io as block_io,
+    BLOCK_QUEUE_SIZES, BOOT_SEG_MAX, MAX_DISCARD_SECTORS, SECTOR_SHIFT, SECTOR_SIZE,
+    VirtioBlockError, io as block_io,
 };
 use crate::devices::virtio::ActivateError;
 use crate::devices::virtio::block::CacheType;
@@ -579,7 +579,7 @@ impl VirtioBlock {
 
         let mut config_space = ConfigSpace {
             capacity: disk_properties.nsectors.to_le(),
-            seg_max: SEG_MAX.to_le(),
+            seg_max: BOOT_SEG_MAX.to_le(),
             ..Default::default()
         };
 
@@ -1550,7 +1550,7 @@ mod tests {
             // seg_max: a request may carry up to SEG_MAX data descriptors.
             let expected_config_space = ConfigSpace {
                 capacity: 8,
-                seg_max: SEG_MAX,
+                seg_max: BOOT_SEG_MAX,
                 ..Default::default()
             };
             assert_eq!(config, expected_config_space.as_slice());
diff --git a/src/vmm/src/devices/virtio/block/virtio/mod.rs b/src/vmm/src/devices/virtio/block/virtio/mod.rs
index 610b69913..8ea725f99 100644
--- a/src/vmm/src/devices/virtio/block/virtio/mod.rs
+++ b/src/vmm/src/devices/virtio/block/virtio/mod.rs
@@ -39,6 +39,13 @@ pub const MAX_DISCARD_SECTORS: u32 = (128_u32 << 20) / SECTOR_SIZE;
 /// upstream prototype and of other forks, so a guest that negotiated it with this build stays
 /// within the limit of an implementation that enforces it.
 pub const SEG_MAX: u32 = 32;
+/// New devices in the isolated experiment offer 64 segments. The legacy restored-device
+/// value above is separate because snapshot 12.1 does not record the numeric segment limit.
+pub(super) const BOOT_SEG_MAX: u32 = if cfg!(feature = "sg64-experiment") {
+    64
+} else {
+    SEG_MAX
+};
 /// The number of queues of block device.
 pub const BLOCK_NUM_QUEUES: usize = 1;
 pub const BLOCK_QUEUE_SIZES: [u16; BLOCK_NUM_QUEUES] = [FIRECRACKER_MAX_QUEUE_SIZE];
diff --git a/src/vmm/src/rpc_interface.rs b/src/vmm/src/rpc_interface.rs
index 9e8087ccb..c0382b915 100644
--- a/src/vmm/src/rpc_interface.rs
+++ b/src/vmm/src/rpc_interface.rs
@@ -175,6 +175,25 @@ pub enum VmmAction {
     GetMigrationMemoryDigest,
 }
 
+#[cfg(feature = "sg64-experiment")]
+impl VmmAction {
+    /// An experimental guest must boot with this build's segment limit. A 12.1 snapshot
+    /// cannot tell the target which limit was negotiated, so this binary is boot-only.
+    fn reject_experimental_state_transfer(&self) -> Result<(), VmmActionError> {
+        match self {
+            Self::CreateSnapshot(_)
+            | Self::LoadSnapshot(_)
+            | Self::GetMigration
+            | Self::MigrationSendRound(_)
+            | Self::MigrationReceiveRound(_)
+            | Self::GetMigrationMemoryDigest => Err(VmmActionError::NotSupported(
+                "sg64-experiment disables snapshots and migration".into(),
+            )),
+            _ => Ok(()),
+        }
+    }
+}
+
 /// Wrapper for all errors associated with VMM actions.
 #[derive(Debug, thiserror::Error, displaydoc::Display)]
 pub enum VmmActionError {
@@ -471,6 +490,9 @@ impl<'a> PrebootApiController<'a> {
         &mut self,
         request: VmmAction,
     ) -> Result<VmmData, VmmActionError> {
+        #[cfg(feature = "sg64-experiment")]
+        request.reject_experimental_state_transfer()?;
+
         use self::VmmAction::*;
 
         match request {
@@ -776,6 +798,9 @@ impl RuntimeApiController {
         request: VmmAction,
         event_manager: &mut EventManager,
     ) -> Result<VmmData, VmmActionError> {
+        #[cfg(feature = "sg64-experiment")]
+        request.reject_experimental_state_transfer()?;
+
         use self::VmmAction::*;
         match request {
             // Supported operations allowed post-boot.
-- 
2.43.0

