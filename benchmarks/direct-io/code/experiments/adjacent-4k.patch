+    #[test]
+    fn test_adjacent_read_pair_snapshot_and_limiter() {
+        use crate::vmm_config::machine_config::HugePageConfig;
+        use crate::vstate::memory::{self, Bitmap, GuestRegionMmapExt};
+        use vm_memory::{GuestMemoryBackend, GuestMemoryRegion};
+
+        for (ops, second_write, second_offset, second_guest, paired) in [
+            (2, false, 0x10000, 0x20000, true),
+            (1, false, 0x10000, 0x20000, false),
+            (2, true, 0x10000, 0x20000, false),
+            (2, false, 0, 0x20000, false),
+            (2, false, 0x10000, 0x10000, false),
+        ] {
+            let mem = GuestMemoryMmap::from_regions(
+                memory::anonymous(
+                    [(GuestAddress(0), 0x40000)].into_iter(),
+                    true,
+                    HugePageConfig::None,
+                    false,
+                )
+                .unwrap()
+                .into_iter()
+                .map(|r| GuestRegionMmapExt::dram_from_mmap_region(r, 0))
+                .collect(),
+            )
+            .unwrap();
+            let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+            let (mut block, f) = direct_block(&mem, &vq);
+            f.as_file().write_all(&[0x22; 0x10000]).unwrap();
+            block
+                .update_disk_image(f.as_path().to_str().unwrap().into())
+                .unwrap();
+            block.metrics = Arc::new(BlockDeviceMetrics::default());
+            set_rate_limiter(
+                &mut block,
+                RateLimiter::new(0x20000, 0, 1_000_000, ops, 0, 1_000_000),
+            );
+            put_req(&vq, 0, false, 0, 0x10000, 0x10000);
+            put_req(&vq, 1, second_write, second_offset, second_guest, 0x10000);
+            vq.avail.idx.set(2);
+            block.process_queue(0).unwrap();
+            let count = if ops == 1 { 1 } else { 2 };
+            assert_eq!(block.queues[0].next_avail.0, count);
+            assert_eq!(block.rate_limiter.is_blocked(), ops == 1);
+            let FileEngine::Async(engine) = &block.disk.file_engine else {
+                unreachable!()
+            };
+            assert_eq!(engine.in_flight(), u32::from(count) - u32::from(paired));
+            assert_eq!(block.metrics.direct_read_pairs.count(), u64::from(paired));
+            block.prepare_save().unwrap();
+            assert_eq!(vq.used.idx.get(), count);
+            let mut completions = (0..usize::from(count))
+                .map(|i| {
+                    let e = vq.used.ring[i].get();
+                    (e.id, e.len)
+                })
+                .collect::<Vec<_>>();
+            completions.sort_unstable();
+            assert_eq!(completions[0], (0, 0x10001));
+            assert_eq!(u32::from(req_status(&mem, 0)), VIRTIO_BLK_S_OK);
+            if count == 2 {
+                assert_eq!(completions[1], (3, if second_write { 1 } else { 0x10001 }));
+                assert_eq!(u32::from(req_status(&mem, 1)), VIRTIO_BLK_S_OK);
+            } else {
+                assert_eq!(req_status(&mem, 1), 0xff);
+            }
+            if paired {
+                let bitmap = mem.find_region(GuestAddress(0)).unwrap().bitmap();
+                for page in (0x10000..0x30000).step_by(4096) {
+                    assert!(bitmap.dirty_at(page));
+                }
+                let mut data = vec![0; 0x20000];
+                mem.read_slice(&mut data, GuestAddress(0x10000)).unwrap();
+                assert!(data[..0x10000].iter().all(|&v| v == 0x11));
+                assert!(data[0x10000..].iter().all(|&v| v == 0x22));
+                assert_eq!(block.metrics.read_count.count(), 2);
+                assert_eq!(block.metrics.read_bytes.count(), 0x20000);
+                assert!(!block.rate_limiter.consume(1, TokenType::Ops));
+            }
+        }
+    }
