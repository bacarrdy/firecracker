+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        let (mut block, f) = direct_block(&mem, &vq);
+        f.as_file().set_len(0x20000).unwrap();
+        block
+            .update_disk_image(f.as_path().to_str().unwrap().into())
+            .unwrap();
+        f.as_file().write_all_at(&[0x33; 4096], 0x10000).unwrap();
+        f.as_file().set_len(0x11000).unwrap();
+        mem.write_slice(&[0xaa; 4096], GuestAddress(0x30000))
+            .unwrap();
+        put_req(&vq, 0, false, 0, 0x10000, 0x10000);
+        put_req(&vq, 1, false, 0x10000, 0x20000, 0x10000);
+        // A write to the second child's data may not overtake replay after short O_DIRECT IO.
+        put_req(&vq, 2, true, 0x10000, 0x30000, 4096);
+        vq.avail.idx.set(3);
+        block.process_queue(0).unwrap();
+        assert_eq!(block.queues[0].next_avail.0, 2);
+        assert_eq!(file_bytes(&f, 0x10000, 4096), vec![0x33; 4096]);
+        block.prepare_save().unwrap();
+        assert_eq!(vq.used.idx.get(), 2);
+        assert_eq!(u32::from(req_status(&mem, 0)), VIRTIO_BLK_S_OK);
+        assert_eq!(u32::from(req_status(&mem, 1)), VIRTIO_BLK_S_IOERR);
+        let bitmap = mem.find_region(GuestAddress(0)).unwrap().bitmap();
+        for offset in (0x10000..0x30000).step_by(4096) {
+            assert!(bitmap.dirty_at(offset));
+        }
+        let mut data = vec![0; 4096];
+        mem.read_slice(&mut data, GuestAddress(0x20000)).unwrap();
+        assert_eq!(data, vec![0x33; 4096]);
+        assert_eq!(req_status(&mem, 2), 0xff);
+        block.process_queue(0).unwrap();
+        block.prepare_save().unwrap();
+        assert_eq!(vq.used.idx.get(), 3);
+        assert_eq!(file_bytes(&f, 0x10000, 4096), vec![0xaa; 4096]);
+    }
