+    #[test]
+    fn test_adjacent_read_completion_prefix() {
+        for (prefix, error) in [
+            (0, true),
+            (2048, true),
+            (4096, true),
+            (6100, true),
+            (2048, false),
+            (6100, false),
+            (8192, false),
+        ] {
+            let mem = single_region_mem(0x1000);
+            let metrics = BlockDeviceMetrics::default();
+            let child = |id| PendingRequest {
+                desc_idx: id,
+                status_addr: GuestAddress(0x100 + u64::from(id)),
+                data_len: 4096,
+                ..Default::default()
+            };
+            let mut pair = child(2);
+            pair.adjacent_read = Some(Box::new(child(5)));
+            let result = if error {
+                Err(IoErr::PartialTransfer {
+                    completed: prefix,
+                    expected: 8192,
+                })
+            } else {
+                Ok(prefix)
+            };
+            let [Some(first), Some(second)] = pair.finish_async(&mem, result, prefix, &metrics)
+            else {
+                panic!("missing child completion")
+            };
+            for (c, id, transferred) in [
+                (first, 2, prefix.min(4096)),
+                (second, 5, prefix.saturating_sub(4096)),
+            ] {
+                assert_eq!(c.desc_idx, id);
+                assert_eq!(c.num_bytes_to_mem, transferred + 1);
+                let status = mem
+                    .read_obj::<u8>(GuestAddress(0x100 + u64::from(id)))
+                    .unwrap();
+                assert_eq!(
+                    u32::from(status),
+                    if transferred == 4096 {
+                        VIRTIO_BLK_S_OK
+                    } else {
+                        VIRTIO_BLK_S_IOERR
+                    }
+                );
+            }
+            assert_eq!(metrics.read_bytes.count(), u64::from(prefix));
+            assert_eq!(metrics.read_count.count(), u64::from(prefix / 4096));
+        }
+    }
