+    #[test]
+    fn test_adjacent_read_pair_short_replays_children() {
+        use std::os::unix::fs::FileExt;
+        let mem = single_region_mem(0x40000);
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 16);
+        let (mut block, f) = direct_block(&mem, &vq);
+        f.as_file().set_len(0x20000).unwrap();
+        block
+            .update_disk_image(f.as_path().to_str().unwrap().into())
+            .unwrap();
+        // The disk shrinks after virtio learned its size. The first child remains completely
+        // readable, the second remains half readable and then reaches EOF.
+        f.as_file().write_all_at(&[0x44; 0x8000], 0x10000).unwrap();
+        f.as_file().set_len(0x18000).unwrap();
+        block.metrics = Arc::new(BlockDeviceMetrics::default());
+        set_rate_limiter(
+            &mut block,
+            RateLimiter::new(0x20000, 0, 1_000_000, 2, 0, 1_000_000),
+        );
+        put_req(&vq, 0, false, 0, 0x10000, 0x10000);
+        put_req(&vq, 1, false, 0x10000, 0x20000, 0x10000);
+        vq.avail.idx.set(2);
+        block.process_queue(0).unwrap();
+        assert_eq!(block.metrics.direct_read_pairs.count(), 1);
+        block.prepare_save().unwrap();
+        assert_eq!(vq.used.idx.get(), 2);
+        let mut results = (0..2)
+            .map(|n| {
+                let element = vq.used.ring[n].get();
+                (element.id, element.len)
+            })
+            .collect::<Vec<_>>();
+        results.sort_unstable();
+        assert_eq!(results, [(0, 0x10001), (3, 0x8001)]);
+        assert_eq!(u32::from(req_status(&mem, 0)), VIRTIO_BLK_S_OK);
+        assert_eq!(u32::from(req_status(&mem, 1)), VIRTIO_BLK_S_IOERR);
+        let mut data = vec![0; 0x20000];
+        mem.read_slice(&mut data, GuestAddress(0x10000)).unwrap();
+        assert!(data[..0x10000].iter().all(|&b| b == 0x11));
+        assert!(data[0x10000..0x18000].iter().all(|&b| b == 0x44));
+        assert!(data[0x18000..].iter().all(|&b| b == 0));
+        assert_eq!(block.metrics.read_count.count(), 1);
+        assert_eq!(block.metrics.read_bytes.count(), 0x18000);
+        assert_eq!(block.metrics.invalid_reqs_count.count(), 1);
+        assert!(!block.rate_limiter.consume(1, TokenType::Ops));
+    }
