+    #[test]
+    fn indirect_table_parses_scattered_payload_and_keeps_outer_head() {
+        let mem = single_region_mem(0x80000);
+        let vq = VirtQueue::new(GuestAddress(0x70000), &mem, 256);
+        let table_addr = GuestAddress(0x60000);
+        for count in [1, 32, 33] {
+            let segments = multi_chain(&vq, VIRTIO_BLK_T_IN, 0, &vec![(512, true); count]);
+            vq.dtable[count + 1].addr.set(0x5f000);
+            let length = (count + 2) * size_of::<Descriptor>();
+            // Copy a normally constructed Linux-style table outside the main ring.
+            let mut bytes = vec![0; length];
+            mem.read_slice(&mut bytes, vq.dtable_start()).unwrap();
+            mem.write_slice(&bytes, table_addr).unwrap();
+            vq.dtable[211].set(table_addr.0, length as u32, 4 | VIRTQ_DESC_F_WRITE, 0);
+            vq.avail.ring[0].set(211);
+            let mut q = vq.create_queue();
+            let head = q.pop().unwrap().unwrap();
+            assert!(Request::parse_negotiated(&head, &mem, NUM_DISK_SECTORS, false).is_err());
+            let result = Request::parse_negotiated(&head, &mem, NUM_DISK_SECTORS, true);
+            if count == 33 {
+                assert!(matches!(
+                    result,
+                    Err((
+                        VirtioBlockError::UnexpectedDataDescriptors,
+                        Some(GuestAddress(0x5f000))
+                    ))
+                ));
+            } else {
+                let req = result.unwrap();
+                assert_eq!(req.data_len, (count * 512) as u32);
+                assert_eq!(req.data_addr, segments[0].0);
+                if count == 1 {
+                    assert!(req.segments.is_empty());
+                } else {
+                    assert_eq!(req.segments, segments);
+                }
+                assert_eq!(req.to_pending_request(head.index).desc_idx, 211);
+            }
+        }
+    }
+
+    #[test]
+    fn indirect_table_after_direct_prefix_preserves_flush_and_status() {
+        let mem = single_region_mem(0x20000);
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 8);
+        mem.write_obj(
+            RequestHeader::new(VIRTIO_BLK_T_FLUSH, 0),
+            GuestAddress(0x1000),
+        )
+        .unwrap();
+        vq.dtable[3].set(0x1000, 16, VIRTQ_DESC_F_NEXT, 7);
+        vq.dtable[7].set(0x3000, 16, 4 | VIRTQ_DESC_F_WRITE, 0);
+        let status = Descriptor {
+            addr: 0x4000,
+            len: 1,
+            flags: VIRTQ_DESC_F_WRITE,
+            next: 0,
+        };
+        mem.write_obj(status, GuestAddress(0x3000)).unwrap();
+        vq.avail.ring[0].set(3);
+        vq.avail.idx.set(1);
+        let mut q = vq.create_queue();
+        let head = q.pop().unwrap().unwrap();
+        let req = Request::parse_negotiated(&head, &mem, NUM_DISK_SECTORS, true).unwrap();
+        assert_eq!(req.r#type, RequestType::Flush);
+        assert_eq!(req.data_len, 0);
+        assert_eq!(req.status_addr, GuestAddress(0x4000));
+        assert_eq!(req.to_pending_request(head.index).desc_idx, 3);
+    }
+
+    #[test]
+    fn indirect_table_rejects_unsupported_layouts_before_status() {
+        let mem = single_region_mem(0x20000);
+        let vq = VirtQueue::new(GuestAddress(0), &mem, 8);
+        vq.avail.ring[0].set(0);
+        vq.avail.idx.set(1);
+        let check = |addr, len, flags, entry_flags, next| {
+            vq.dtable[0].set(addr, len, flags, 1);
+            mem.write_obj(
+                Descriptor {
+                    addr: 0x1000,
+                    len: 16,
+                    flags: entry_flags,
+                    next,
+                },
+                GuestAddress(0x3000),
+            )
+            .unwrap();
+            let mut q = vq.create_queue();
+            let head = q.pop().unwrap().unwrap();
+            assert!(matches!(
+                Request::parse_negotiated(&head, &mem, NUM_DISK_SECTORS, true),
+                Err((_, None))
+            ));
+        };
+        check(0x3000, 0, 4, 0, 0);
+        check(0x3000, 15, 4, 0, 0);
+        check(0x3000, 16, 4 | VIRTQ_DESC_F_NEXT, 0, 0);
+        check(0x3000, 16, 4, 4, 0);
+        check(0x3000, 16, 4, VIRTQ_DESC_F_NEXT, 1);
+        check(0x3000, 16, 4, VIRTQ_DESC_F_NEXT, 0);
+        check(0x20000 - 8, 16, 4, 0, 0);
+    }
