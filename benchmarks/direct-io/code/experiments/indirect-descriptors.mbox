-                if seen_writable {
-                    return Err(VirtioBlockError::UnexpectedReadOnlyDescriptor);
+                readable.push(addr, len)
+            }
+        };
+
+        let mut desc = *avail_desc;
+        loop {
+            if desc.flags & INDIRECT != 0 {
+                if !indirect || desc.flags & VIRTQ_DESC_F_NEXT != 0 {
+                    return Err(VirtioBlockError::DescriptorChainTooShort);
+                }
+                let stride = size_of::<Descriptor>() as u32;
+                if desc.len == 0 || desc.len % stride != 0 {
+                    return Err(VirtioBlockError::InvalidDataLength);
                 }
-                readable.push(desc.addr, desc.len)?;
+                mem.check_range_plugged(desc.addr, desc.len as usize)
+                    .map_err(VirtioBlockError::GuestMemory)?;
+                let entries = desc.len / stride;
+                let mut index = 0u16;
+                // The original queue size bounds the work, even for a table with
+                // unused slots. A regular prefix and the table share this budget.
+                for _ in 0..desc.remaining_descriptors() {
+                    if u32::from(index) >= entries {
+                        break;
+                    }
+                    let addr = desc
+                        .addr
+                        .checked_add(u64::from(index) * u64::from(stride))
+                        .ok_or(VirtioBlockError::GuestMemory(
+                            GuestMemoryError::GuestAddressOverflow,
+                        ))?;
+                    let entry: Descriptor =
+                        mem.read_obj(addr).map_err(VirtioBlockError::GuestMemory)?;
+                    if entry.flags & INDIRECT != 0 {
+                        break;
+                    }
+                    push(GuestAddress(entry.addr), entry.len, entry.flags)?;
+                    if entry.flags & VIRTQ_DESC_F_NEXT == 0 {
+                        return Ok(());
+                    }
+                    index = entry.next;
+                }
+                return Err(VirtioBlockError::DescriptorChainTooShort);
             }
+            push(desc.addr, desc.len, desc.flags)?;
             if desc.flags & VIRTQ_DESC_F_NEXT == 0 {
-                break;
+                return Ok(());
             }
