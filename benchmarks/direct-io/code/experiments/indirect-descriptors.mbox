--- a/src/vmm/src/rpc_interface.rs
+++ b/src/vmm/src/rpc_interface.rs
@@ -175,6 +175,28 @@ pub enum VmmAction {
     GetMigrationMemoryDigest,
 }
 
+#[cfg(feature = "block-indirect-experiment")]
+impl VmmAction {
+    fn reject_indirect_state_transfer(&self) -> Result<(), VmmActionError> {
+        use crate::devices::virtio::block::virtio::experimental_indirect_drive;
+        if matches!(
+            self,
+            Self::CreateSnapshot(_)
+                | Self::LoadSnapshot(_)
+                | Self::GetMigration
+                | Self::MigrationSendRound(_)
+                | Self::MigrationReceiveRound(_)
+                | Self::GetMigrationMemoryDigest
+        ) && experimental_indirect_drive().is_some()
+        {
+            return Err(VmmActionError::NotSupported(
+                "private block indirect experiment disables snapshots and migration".into(),
+            ));
+        }
+        Ok(())
+    }
+}
