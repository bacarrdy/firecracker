+    /// Ask the kernel to dispatch this SQE through io-wq.
+    pub(crate) fn request_async(&mut self) {
+        self.flags |= 1 << io_uring_sqe_flags_bit::IOSQE_ASYNC_BIT;
+    }
+
     pub(crate) fn fd(&self) -> FixedFd {
         self.fd
     }
