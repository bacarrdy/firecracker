+/// One outstanding read hint per eligible drive. Losing optional metadata disables the hint.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ReadDispatch {
+    Disabled,
+    Available,
+    Outstanding,
+}
+
+impl ReadDispatch {
+    fn for_backing(file: &File, dio: Option<DioAlign>) -> Self {
+        if cfg!(feature = "experimental-burst-read-dispatch")
+            && dio.is_some()
+            && file
+                .metadata()
+                .is_ok_and(|m| m.file_type().is_block_device())
+        {
+            Self::Available
+        } else {
+            Self::Disabled
+        }
+    }
+}
+
