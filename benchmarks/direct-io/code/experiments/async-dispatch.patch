+
+    fn push_new_data(
+        &mut self,
+        mut op: GuestOp,
+        nonempty_read: bool,
+    ) -> Result<(), RequestError<AsyncIoError>> {
+        // A locally staged SQE cannot have finished: this read will share a submission burst.
+        // The token stays with this window until its CQE is consumed, even across short submits.
+        let hint = cfg!(feature = "experimental-burst-read-dispatch")
+            && self.read_dispatch == ReadDispatch::Available
+            && nonempty_read
+            && self.ring.unsubmitted_sqes() != 0;
+        op.dispatch_hint = hint;
+        let mut operation = op.operation().map_err(|op| RequestError {
             req: op.req,
             error: AsyncIoError::IO(std::io::Error::other("invalid I/O window")),
         })?;
+        if hint {
+            operation.request_async();
+        }
         self.ring
             .push(operation)
             .map_err(|(error, data)| RequestError {
                 req: data.into_req(),
                 error: AsyncIoError::IoUring(error),
-            })
+            })?;
+        if hint {
+            self.read_dispatch = ReadDispatch::Outstanding;
+        }
+        Ok(())
     }
 
     pub fn push_flush(&mut self, req: PendingRequest) -> Result<(), RequestError<AsyncIoError>> {
