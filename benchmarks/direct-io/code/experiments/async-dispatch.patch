     use super::*;
 
+    #[cfg(feature = "experimental-burst-read-dispatch")]
+    #[test]
+    #[ignore = "requires FC_DISPATCH_READ_LOOP pointing to a dedicated 4Kn loop"]
+    fn test_burst_read_dispatch() {
+        use std::os::unix::fs::OpenOptionsExt;
+
+        use crate::test_utils::single_region_mem;
+
+        let path = std::env::var_os("FC_DISPATCH_READ_LOOP").unwrap();
+        let raw = File::options()
+            .read(true)
+            .custom_flags(libc::O_DIRECT)
+            .open(&path)
+            .unwrap();
+        let dio = DioAlign::probe(&raw).unwrap();
+        let mut engine = AsyncFileEngine::from_file(raw, Some(dio), false).unwrap();
+        let mem = single_region_mem(1 << 20);
+        let req = PendingRequest::default;
+        let push = |engine: &mut AsyncFileEngine, addr, size| {
+            engine.push_read(0, &mem, GuestAddress(addr), size, req())
+        };
+        assert_eq!(engine.read_dispatch, ReadDispatch::Available);
+        // Production ring permits a vectored hint. A failed push must not take the token.
+        push(&mut engine, 0, 4096).unwrap();
+        engine.fail_ring_for_test(1, 0);
+        assert!(push(&mut engine, 4096, 4096).is_err());
+        assert_eq!(engine.read_dispatch, ReadDispatch::Available);
+        engine
+            .push_readv(
+                0,
+                &mem,
+                vec![(GuestAddress(0x2000), 4096), (GuestAddress(0x4000), 4096)],
+                req(),
+            )
+            .unwrap();
+        assert_eq!(engine.read_dispatch, ReadDispatch::Outstanding);
+        engine.fail_ring_for_test(0, 1);
+        assert!(engine.kick_submission_queue().is_err());
+        assert_eq!(engine.read_dispatch, ReadDispatch::Outstanding);
+        engine.drain(false).unwrap();
+        let mut sizes: Vec<_> = (0..2)
+            .map(|_| engine.pop(&mem).unwrap().unwrap().result().unwrap())
+            .collect();
+        sizes.sort_unstable();
+        assert_eq!(sizes, [4096, 8192]);
+        assert_eq!(engine.read_dispatch, ReadDispatch::Available);
+
+        // Temporarily deny IOSQE_ASYNC using the kernel's per-ring restriction:
+        // only the selected read can fail, and its CQE must return the token on error.
+        engine.ring = AsyncFileEngine::new_ring(
+            &engine.file,
+            engine.completion_evt.as_raw_fd(),
+            None,
+            ReadDispatch::Disabled,
+        )
+        .unwrap();
+        for size in [4096, 8192, 65536] {
+            push(&mut engine, 0, size).unwrap();
+            engine.drain(false).unwrap();
+            assert_eq!(engine.pop(&mem).unwrap().unwrap().result().unwrap(), size);
+            for i in 0..8 {
+                push(&mut engine, i * 65536, size).unwrap();
+                assert_eq!(
+                    engine.read_dispatch,
+                    if i == 0 {
+                        ReadDispatch::Available
+                    } else {
+                        ReadDispatch::Outstanding
+                    }
+                );
+            }
+            engine.kick_submission_queue().unwrap();
+            // No re-issue before the marked CQE is reaped, even in a later burst.
+            for i in 8..12 {
+                push(&mut engine, i * 65536, size).unwrap();
+            }
+            assert_eq!(
+                engine
+                    .ring
+                    .pending_user_data()
+                    .filter(|w| matches!(w, WrappedRequest::Guest(op) if op.dispatch_hint))
+                    .count(),
+                1
+            );
+            engine.drain(false).unwrap();
+            let mut denied = 0;
+            for _ in 0..12 {
+                match engine.pop(&mem).unwrap().unwrap().result() {
+                    Ok(bytes) => assert_eq!(bytes, size),
+                    Err(error) => {
+                        assert_eq!(error.raw_os_error(), Some(-libc::EIO));
+                        denied += 1;
+                    }
+                }
+            }
+            assert_eq!(denied, 1);
+            assert_eq!(engine.read_dispatch, ReadDispatch::Available);
+        }
+
+        // New backing determines eligibility independently of the previous ring.
+        engine
+            .update_file(File::open(&path).unwrap(), None)
+            .unwrap();
+        assert_eq!(engine.read_dispatch, ReadDispatch::Disabled);
+        let regular = TempFile::new().unwrap();
+        regular.as_file().set_len(65536).unwrap();
+        let file = File::options()
+            .read(true)
+            .custom_flags(libc::O_DIRECT)
+            .open(regular.as_path())
+            .unwrap();
+        let dio = DioAlign::probe(&file).unwrap();
+        engine.update_file(file, Some(dio)).unwrap();
+        for i in 0..4 {
+            push(&mut engine, i * 4096, 4096).unwrap();
+        }
+        engine.drain(false).unwrap();
+        for _ in 0..4 {
+            assert_eq!(engine.pop(&mem).unwrap().unwrap().result().unwrap(), 4096);
+        }
+        assert_eq!(engine.read_dispatch, ReadDispatch::Disabled);
+    }
+
     #[test]
     fn test_kernel_release_at_least() {
         assert_eq!(
diff --git a/src/vmm/src/io_uring/operation/mod.rs b/src/vmm/src/io_uring/operation/mod.rs
