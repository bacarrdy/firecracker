+    #[test]
+    fn test_window_bounds_and_restoration() {
+        let entry = |len| libc::iovec {
+            iov_base: std::ptr::null_mut(),
+            iov_len: len,
+        };
+        let mut spans = [entry(16), entry(64), entry(8)];
+        for (limit, lengths) in [
+            (0, &[][..]),
+            (16, &[16][..]),
+            (32, &[16, 16][..]),
+            (88, &[16, 64, 8][..]),
+        ] {
+            let mut window = IoWindow::prepare(&mut spans, limit);
+            let active = window.slice(&spans);
+            assert_eq!(active.as_ptr(), spans.as_ptr());
+            assert_eq!(
+                active.iter().map(|iov| iov.iov_len).collect::<Vec<_>>(),
+                lengths
+            );
+            assert_eq!(window.bytes, lengths.iter().sum::<usize>());
+            window.restore(&mut spans);
+            assert_eq!(spans.map(|iov| iov.iov_len), [16, 64, 8]);
+        }
+        let mut many = vec![entry(1); MAX_IOVECS + 1];
+        let window = IoWindow::prepare(&mut many, MAX_IO_BYTES);
+        assert_eq!((window.entries, window.bytes), (MAX_IOVECS, MAX_IOVECS));
+    }
