+/// One host I/O over a prefix of the request-owned iovecs. Only the last iovec
+/// may need shortening. Restore it before consuming a completion or retrying.
+#[derive(Debug, Default)]
+struct IoWindow {
+    entries: usize,
+    bytes: usize,
+    original_tail_len: Option<usize>,
 }
 
-fn io_window_with_limit(
-    iovecs: &[libc::iovec],
-    window: &mut Vec<libc::iovec>,
-    limit: usize,
-) -> usize {
-    window.clear();
-    let mut bytes = 0;
-    for iov in iovecs.iter().take(MAX_IOVECS) {
-        let len = iov.iov_len.min(limit - bytes);
-        if len == 0 {
-            break;
+impl IoWindow {
+    fn prepare(iovecs: &mut [libc::iovec], limit: usize) -> Self {
+        let mut window = Self::default();
+        for iov in iovecs.iter_mut().take(MAX_IOVECS) {
+            let available = limit - window.bytes;
+            if available == 0 || iov.iov_len == 0 {
+                break;
+            }
+            window.entries += 1;
+            if iov.iov_len > available {
+                window.original_tail_len = Some(std::mem::replace(&mut iov.iov_len, available));
+                window.bytes = limit;
+                break;
+            }
+            window.bytes += iov.iov_len;
         }
-        window.push(libc::iovec {
-            iov_base: iov.iov_base,
-            iov_len: len,
-        });
-        bytes += len;
-        if bytes == limit {
-            break;
+        window
+    }
+
+    fn slice<'a>(&self, iovecs: &'a [libc::iovec]) -> &'a [libc::iovec] {
+        &iovecs[..self.entries]
+    }
+
+    fn restore(&mut self, iovecs: &mut [libc::iovec]) {
+        if let Some(length) = self.original_tail_len.take() {
+            iovecs[self.entries - 1].iov_len = length;
         }
     }
-    bytes
 }
 
 /// The host iovecs of a request's data segments. Fails if a segment is not inside guest memory
