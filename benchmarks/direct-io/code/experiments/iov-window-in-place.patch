+    #[test]
+    fn test_async_clipped_continuation_survives_a_refused_push() {
+        use std::os::unix::fs::FileExt;
+
+        let mem = mem_of(0x10000);
+        let spans = [
+            (GuestAddress(0), 256),
+            (GuestAddress(4096), 1024),
+            (GuestAddress(8192), 256),
+        ];
+        let payload: Vec<u8> = (0..1536).map(|i| (i / 127 + i % 11) as u8).collect();
+        for write in [true, false] {
+            let file = TempFile::new().unwrap().into_file();
+            file.write_all_at(&[0xde; 1538], 0).unwrap();
+            let mut pos = 0;
+            for (addr, len) in spans {
+                let end = pos + len as usize;
+                if write {
+                    mem.write_slice(&payload[pos..end], addr).unwrap();
+                } else {
+                    mem.write_slice(&vec![0; len as usize], addr).unwrap();
+                }
+                pos = end;
+            }
+            if !write {
+                file.write_all_at(&payload, 1).unwrap();
+            }
+            let mut engine = AsyncFileEngine::from_test_backings(file, None, false).unwrap();
+            engine.set_test_window_limit(512);
+            if write {
+                engine
+                    .push_writev(1, &mem, spans.to_vec(), PendingRequest::default())
+                    .unwrap();
+            } else {
+                engine
+                    .push_readv(1, &mem, spans.to_vec(), PendingRequest::default())
+                    .unwrap();
+            }
+            engine.drain(false).unwrap();
+            engine.fail_ring_for_test(1, 0);
+            assert!(engine.pop(&mem).is_err());
+            assert_eq!(engine.ring_failures_left_for_test(), (0, 0));
+            let result = loop {
+                engine.drain(false).unwrap();
+                if let Some(cqe) = engine.pop(&mem).unwrap() {
+                    break cqe.result().unwrap();
+                }
+            };
+            assert_eq!(result, 1536);
+            assert_eq!(engine.in_flight(), 0);
+            let mut disk = [0; 1538];
+            engine.file().read_exact_at(&mut disk, 0).unwrap();
+            assert_eq!((disk[0], disk[1537]), (0xde, 0xde));
+            assert_eq!(&disk[1..1537], payload.as_slice());
+            let mut pos = 0;
+            for (addr, len) in spans {
+                let mut data = vec![0; len as usize];
+                mem.read_slice(&mut data, addr).unwrap();
+                assert_eq!(data, &payload[pos..pos + len as usize]);
+                pos += len as usize;
+            }
+        }
+    }
+
