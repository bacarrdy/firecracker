+    fn checked_read_from() {
+        let start_addr1 = GuestAddress(0x0);
+        let start_addr2 = GuestAddress(0x40);
+        let mem = GuestMemoryMmap::from_ranges(&[(start_addr1, 64), (start_addr2, 64)]).unwrap();
+        let image = make_image(0x80);
