+                    queue.avail.idx.set(1);
+                    simulate_queue_event(&mut block, None);
+                    complete_until(&mut block, &queue, 1);
+                    assert_eq!(u32::from(req_status(&mem, 0)), VIRTIO_BLK_S_OK);
+                }
+            }
+        }
+    }
