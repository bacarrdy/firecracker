+    /// End the bounce in progress and return its guest request's completion.
+    fn finish_bounce(&mut self, res: Result<(), std::io::Error>) -> Cqe<Done> {
+        let ActiveBounce {
+            plan, req, started, ..
+        } = self.bounce.take().expect("a bounce is in progress");
+        let res = match res {
+            Ok(()) => i64::from(plan.count()),
+            Err(err) => {
+                let errno = err.raw_os_error().map(i32::abs).unwrap_or(libc::EIO);
+                if err.raw_os_error().is_none() {
+                    error!("Direct I/O bounce ({:?}) failed: {}", plan.kind(), err);
+                }
+                -i64::from(errno)
+            }
+        };
+        Cqe::new(
+            res,
+            Done {
+                req,
+                bounce: Some((plan.kind(), started.elapsed())),
+            },
+        )
+        .with_progress(if res < 0 { plan.completed() } else { 0 })
+    }
