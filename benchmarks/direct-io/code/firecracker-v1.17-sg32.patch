+    // Multi-segment requests on a direct-I/O drive, both engines: aligned segments go as one
+    // vectored transfer on the O_DIRECT descriptor; a request with any unaligned segment (or an
+    // unaligned offset) goes, whole, through the bounce buffer; reads too. The data lands and
+    // comes back in segment order, the buffered descriptor is never used.
+    #[test]
+    fn test_multi_segment_direct_routes() {
+        for et in [FileEngineType::Sync, FileEngineType::Async] {
+            let m = mem_of(0x100000);
+            let (b, d, mut bc, mut dc) = pair(65536);
+            let mut engine = FileEngine::from_test_backings(b, Some(d), et, false).unwrap();
+            let mut shadow = vec![0u8; 65536];
+            let write = |engine: &mut FileEngine, segs: &[DataSegment], offset: u64| {
+                let total: u32 = segs.iter().map(|s| s.1).sum();
+                let mut data = vec![];
+                for (i, &(addr, len)) in segs.iter().enumerate() {
+                    let bytes: Vec<u8> = (0..len)
+                        .map(|j| (j % 251) as u8 ^ (0x21 * (i as u8 + 1)))
+                        .collect();
+                    m.write_slice(&bytes, addr).unwrap();
+                    data.extend(bytes);
+                }
+                let res =
+                    engine.writev(offset, &m, segs.to_vec(), total, PendingRequest::default());
+                (data, run_result(engine, &m, res))
+            };
+            let read = |engine: &mut FileEngine, segs: &[DataSegment], offset: u64| {
+                let total: u32 = segs.iter().map(|s| s.1).sum();
+                for &(addr, len) in segs {
+                    m.write_slice(&vec![0xeeu8; len as usize], addr).unwrap();
+                }
+                let res = engine.readv(offset, &m, segs.to_vec(), total, PendingRequest::default());
+                let r = run_result(engine, &m, res);
+                let mut back = vec![];
+                for &(addr, len) in segs {
+                    let mut part = vec![0u8; len as usize];
+                    m.read_slice(&mut part, addr).unwrap();
+                    back.extend(part);
+                }
+                (back, r)
+            };
+            // (segments, offset, expected bounce)
+            let cases: Vec<(Vec<DataSegment>, u64, Option<Bounce>)> = vec![
+                // all aligned: direct, vectored
+                (
+                    vec![(GuestAddress(0x1000), 4096), (GuestAddress(0x8000), 8192)],
+                    4096,
+                    None,
+                ),
+                // one segment misaligned in address only: whole blocks from the bounce buffer
+                (
+                    vec![(GuestAddress(0x10000), 4096), (GuestAddress(0x20200), 4096)],
+                    16384,
+                    Some(Bounce::Write),
+                ),
+                // sub-block segments (a 512-byte guest view of a 4096 backing): read-modify-write
+                (
+                    vec![
+                        (GuestAddress(0x30000), 512),
+                        (GuestAddress(0x31000), 1024),
+                        (GuestAddress(0x32e00), 512),
+                    ],
+                    28672 + 512,
+                    Some(Bounce::ReadModifyWrite),
+                ),
+                // aligned segments at an unaligned offset
+                (
+                    vec![(GuestAddress(0x40000), 4096), (GuestAddress(0x42000), 4096)],
+                    36864 + 2048,
+                    Some(Bounce::ReadModifyWrite),
+                ),
+            ];
+            for (segs, offset, bounce) in &cases {
+                let (data, (res, kind)) = write(&mut engine, segs, *offset);
+                assert_eq!(res, Ok(data.len() as u32), "{et:?} {segs:?}");
+                assert_eq!(kind, *bounce, "{et:?} write {segs:?}");
+                shadow[*offset as usize..*offset as usize + data.len()].copy_from_slice(&data);
+                let (back, (res, kind)) = read(&mut engine, segs, *offset);
+                assert_eq!(res, Ok(data.len() as u32), "{et:?} {segs:?}");
+                let want_read = bounce.map(|_| Bounce::Read);
+                assert_eq!(kind, want_read, "{et:?} read {segs:?}");
+                assert!(back == data, "{et:?} read back {segs:?}");
+            }
+            assert!(read_file_prefix(&mut dc, 65536) == shadow, "{et:?}");
+            assert!(
+                read_file_prefix(&mut bc, 65536).iter().all(|&x| x == 0),
+                "{et:?}: the buffered descriptor carried data"
+            );
+        }
+    }
