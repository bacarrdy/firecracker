+    // A multi-segment request through the bounce path: odd segment lengths, misaligned guest
+    // addresses, chunks much smaller than the request so that chunk boundaries fall inside
+    // segments, a partial head and tail block. The bytes land in segment order on the backing
+    // (around them the backing keeps its bytes) and read back into other scattered segments.
+    #[allow(clippy::cast_possible_truncation)]
+    #[test]
+    fn test_bounce_multi_segment() {
+        let mem = mem_of(1 << 20);
+        let tmp = TempFile::new().unwrap();
+        let mut f = tmp.into_file();
+        let disk_len = 256 * 1024;
+        let orig: Vec<u8> = (0..disk_len as u32).map(|i| (i % 239) as u8).collect();
+        f.write_all(&orig).unwrap();
+        let mut slot = None;
+        let src: Vec<DataSegment> = vec![
+            (GuestAddress(0x1003), 100),
+            (GuestAddress(0x9000), 4096),
+            (GuestAddress(0x20200), 412),
+            (GuestAddress(0x30001), 9000),
+            (GuestAddress(0x40000), 4312),
+        ];
+        let count: u32 = src.iter().map(|s| s.1).sum();
+        assert_eq!(count % 512, 0);
+        let mut data = Vec::new();
+        for (i, &(addr, len)) in src.iter().enumerate() {
+            let bytes: Vec<u8> = (0..len)
+                .map(|b| (b % 247) as u8 ^ (0x11 * i as u8))
+                .collect();
+            mem.write_slice(&bytes, addr).unwrap();
+            data.extend(bytes);
+        }
+        let offset = 3 * 4096 + 1536;
+        for chunk in [8192, BOUNCE_BUF_LEN] {
+            let mut plan = BouncePlan::new(true, offset, count, src.clone(), D4K, chunk).unwrap();
+            assert_eq!(plan.kind(), Bounce::ReadModifyWrite);
+            run_sync(&mut plan, &f, &mem, bounce_buf(&mut slot, D4K).unwrap()).unwrap();
+            let mut expect = orig.clone();
+            expect[offset as usize..offset as usize + count as usize].copy_from_slice(&data);
+            let mut got = vec![0u8; disk_len];
+            f.seek(SeekFrom::Start(0)).unwrap();
+            f.read_exact(&mut got).unwrap();
+            assert!(got == expect, "multi-segment write, chunk {chunk}");
+
+            let dst: Vec<DataSegment> = vec![
+                (GuestAddress(0x80005), 7000),
+                (GuestAddress(0x90000), 512),
+                (GuestAddress(0xa0e00), count - 7512),
+            ];
+            for &(addr, len) in &dst {
+                mem.write_slice(&vec![0xeeu8; len as usize], addr).unwrap();
+            }
+            let mut plan = BouncePlan::new(false, offset, count, dst.clone(), D4K, chunk).unwrap();
+            run_sync(&mut plan, &f, &mem, bounce_buf(&mut slot, D4K).unwrap()).unwrap();
+            let mut back = Vec::new();
+            for &(addr, len) in &dst {
+                let mut part = vec![0u8; len as usize];
+                mem.read_slice(&mut part, addr).unwrap();
+                back.extend(part);
+            }
+            assert!(back == data, "multi-segment read, chunk {chunk}");
+        }
+    }
