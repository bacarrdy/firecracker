+    let iters = env_u64("MS_MODEL_ITERS", 600);
+    let base = env_u64("MS_MODEL_SEED", 0x2026_1120_0005);
+    let dev = std::env::var("DIO_MODEL_DEV").ok();
+    for s in 0..seeds {
+        for et in [FileEngineType::Async, FileEngineType::Sync] {
+            for rl in [false, true] {
+                let seed = base.wrapping_add(s * 7919);
+                model(et, seed, iters, dev.as_deref(), rl, true);
+            }
+        }
+    }
