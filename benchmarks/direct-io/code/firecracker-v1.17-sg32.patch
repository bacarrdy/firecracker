 // SPDX-License-Identifier: Apache-2.0
 
 pub mod async_io;
+pub mod direct;
 pub mod sync_io;
 
 use std::fmt::Debug;
 use std::fs::File;
 
+use vm_memory::GuestMemoryBackend;
