+    // The rate limiter's charge is decided in one place: one op for every request, whatever the
+    // number of its data segments; data bytes (all segments) for reads and writes only; a refund
+    // gives back exactly what was taken (a discard deferred behind a read-modify-write must not
+    // refill the bandwidth bucket).
+    #[test]
+    fn test_rate_limit_charge_and_refund() {
+        let req = |t, data_len, segments: Vec<DataSegment>| Request {
+            r#type: t,
+            data_len,
+            status_addr: GuestAddress(0),
+            sector: 0,
+            data_addr: GuestAddress(0),
+            segments,
+        };
+        assert_eq!(
+            req(RequestType::In, 4096, vec![]).rate_limit_charge(),
+            RateLimitCharge {
+                ops: 1,
+                bytes: Some(4096)
+            }
+        );
+        assert_eq!(
+            req(RequestType::Out, 512, vec![]).rate_limit_charge().bytes,
+            Some(512)
+        );
+        // A multi-segment request is one operation and all of its bytes.
+        let segs = vec![
+            (GuestAddress(0x1000), 4096),
+            (GuestAddress(0x3200), 512),
+            (GuestAddress(0x5000), 7680),
+        ];
+        assert_eq!(
+            req(RequestType::Out, 12288, segs.clone()).rate_limit_charge(),
+            RateLimitCharge {
+                ops: 1,
+                bytes: Some(12288)
+            }
+        );
+        assert_eq!(
+            req(RequestType::In, 12288, segs).rate_limit_charge(),
+            RateLimitCharge {
+                ops: 1,
+                bytes: Some(12288)
+            }
+        );
+        for t in [
+            RequestType::Discard,
+            RequestType::Flush,
+            RequestType::GetDeviceID,
+            RequestType::Unsupported(42),
+        ] {
+            assert_eq!(
+                req(t, 1 << 20, vec![]).rate_limit_charge(),
+                RateLimitCharge {
+                    ops: 1,
+                    bytes: None
+                }
+            );
+        }
+        // 1 MiB of bandwidth and 100 ops, refilled over 1000 s: no refill during the test.
+        let mut rl = RateLimiter::new(1 << 20, 0, 1_000_000, 100, 0, 1_000_000);
+        let bytes0 = rl.bandwidth().unwrap().budget();
+        let ops0 = rl.ops().unwrap().budget();
+        for t in [RequestType::Out, RequestType::Discard] {
+            let charge = req(t, 65536, vec![]).rate_limit_charge();
+            charge.take(&mut rl).unwrap().cancel();
+            assert_eq!(rl.bandwidth().unwrap().budget(), bytes0, "{t:?}");
+            assert_eq!(rl.ops().unwrap().budget(), ops0, "{t:?}");
+        }
+        // A discard costs no bandwidth.
+        assert!(
+            req(RequestType::Discard, 65536, vec![])
+                .rate_limit_charge()
+                .take(&mut rl)
+                .is_some()
+        );
+        assert_eq!(rl.bandwidth().unwrap().budget(), bytes0);
+        assert_eq!(rl.ops().unwrap().budget(), ops0 - 1);
+    }
