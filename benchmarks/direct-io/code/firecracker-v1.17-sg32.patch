+    /// The count and bounce of a request that was submitted or executed (nothing else in
+    /// flight).
+    fn run_result(
+        engine: &mut FileEngine,
+        mem: &GuestMemoryMmap,
+        res: Result<FileEngineOk, RequestError<BlockIoError>>,
+    ) -> (Result<u32, String>, Option<Bounce>) {
+        match res {
+            Ok(FileEngineOk::Executed(RequestOk { count, bounce, .. })) => (Ok(count), bounce),
+            Ok(FileEngineOk::Submitted) => {
+                let mut done = complete_all(engine, mem);
+                assert_eq!(done.len(), 1, "exactly one completion");
+                let c = done.pop().unwrap();
+                (c.result, c.bounce)
+            }
+            Ok(FileEngineOk::Deferred(_)) => panic!("deferred with nothing in flight"),
+            Err(err) => (Err(format!("{:?}", err.error)), None),
+        }
+    }
+
+    // The read-modify-write exclusion with multi-segment requests (Async): an RMW waits while
+    // an aligned multi-segment write overlapping its span is in flight, also when that write
+    // waits for the ring between two windows (in the engine's queue, not in the ring); and a
+    // multi-segment write overlapping the span of the RMW in progress waits for it.
+    #[test]
+    fn test_multi_segment_rmw_exclusion() {
+        let m = mem_of(0x100000);
+        let (b, d, _bc, mut dc) = pair(65536);
+        let mut engine =
+            FileEngine::from_test_backings(b, Some(d), FileEngineType::Async, false).unwrap();
+        let FileEngine::Async(e) = &mut engine else {
+            unreachable!()
+        };
+        // Windows of one block: the second window waits in the engine's queue when the ring
+        // refuses it.
+        e.set_test_window_limit(4096);
+        m.write_slice(&[0xa1; 4096], GuestAddress(0x1000)).unwrap();
+        m.write_slice(&[0xa2; 4096], GuestAddress(0x4000)).unwrap();
+        let segs = vec![(GuestAddress(0x1000), 4096), (GuestAddress(0x4000), 4096)];
+        assert!(matches!(
+            engine.writev(8192, &m, segs, 8192, PendingRequest::default()),
+            Ok(FileEngineOk::Submitted)
+        ));
+        let FileEngine::Async(e) = &mut engine else {
+            unreachable!()
+        };
+        e.kick_submission_queue().unwrap();
+        e.drain(false).unwrap();
+        // The first window completed; the ring refuses the second.
+        e.fail_ring_for_test(1, 0);
+        e.pop(&m).unwrap_err();
+        assert_eq!(e.in_flight(), 1, "the second window waits in the engine");
+        // An RMW of the second window's block must wait for it.
+        assert!(!engine.can_proceed(Wait::Span(12288, 16384)));
+        m.write_slice(&[0x5d; 512], GuestAddress(0x9200)).unwrap();
+        assert!(matches!(
+            engine.write(
+                12288 + 512,
+                &m,
+                GuestAddress(0x9200),
+                512,
+                PendingRequest::default()
+            ),
+            Ok(FileEngineOk::Deferred(Wait::Span(12288, 16384)))
+        ));
+        let done = complete_all(&mut engine, &m);
+        assert_eq!(done.len(), 1);
+        assert_eq!(done[0].result, Ok(8192));
+        let (res, kind) = run(&mut engine, true, 12288 + 512, &m, 0x9200, 512);
+        assert_eq!((res, kind), (Ok(512), Some(Bounce::ReadModifyWrite)));
+        let mut want = vec![0xa1u8; 4096];
+        want.extend([0xa2u8; 4096]);
+        want[4096 + 512..4096 + 1024].copy_from_slice(&[0x5d; 512]);
+        assert_eq!(read_file_prefix(&mut dc, 16384)[8192..], want[..]);
+
+        // An RMW in progress: a multi-segment write overlapping its span waits, one elsewhere
+        // goes.
+        m.write_slice(&[0x6e; 512], GuestAddress(0xa000)).unwrap();
+        assert!(matches!(
+            engine.write(
+                512,
+                &m,
+                GuestAddress(0xa000),
+                512,
+                PendingRequest::default()
+            ),
+            Ok(FileEngineOk::Submitted)
+        ));
+        assert!(engine.rmw_in_progress());
+        let over = vec![(GuestAddress(0x1000), 4096), (GuestAddress(0x4000), 4096)];
+        assert!(matches!(
+            engine.writev(0, &m, over.clone(), 8192, PendingRequest::default()),
+            Ok(FileEngineOk::Deferred(Wait::Bounce))
+        ));
+        assert!(matches!(
+            engine.writev(32768, &m, over, 8192, PendingRequest::default()),
+            Ok(FileEngineOk::Submitted)
+        ));
+        let done = complete_all(&mut engine, &m);
+        assert_eq!(done.len(), 2);
+        assert!(done.iter().all(|c| c.result.is_ok()));
+    }
