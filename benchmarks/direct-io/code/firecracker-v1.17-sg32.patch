+    // An unaligned request completes its first bounce chunk before the second chunk's
+    // read (or the tail read of a read-modify-write) encounters EOF.
+    #[test]
+    fn test_bounce_preserves_completed_prefix_on_later_error() {
+        for write_through in [false, true] {
+            check_bounce_prefix_on_error(write_through);
+        }
+    }
+
+    fn check_bounce_prefix_on_error(write_through: bool) {
+        use std::os::unix::fs::FileExt;
+        let chunk = u32::try_from(direct::BOUNCE_BUF_LEN).unwrap();
+        let count = chunk + 512;
+        let mut observed = Vec::new();
+        for ty in [FileEngineType::Sync, FileEngineType::Async] {
+            for write in [false, true] {
+                let mem = mem_of(count as usize + 4096);
+                let addr = GuestAddress(512);
+                let (buffered, direct, _, check) = pair(u64::from(chunk) + 4096);
+                let mut engine =
+                    FileEngine::from_test_backings(buffered, Some(direct), ty, false).unwrap();
+                engine.set_write_through(write_through);
+                check.set_len(u64::from(chunk)).unwrap();
+                check.write_all_at(&vec![0xa5; chunk as usize], 0).unwrap();
+                mem.write_slice(&vec![0x5a; count as usize], addr).unwrap();
+                let req = PendingRequest::default();
+                let res = if write {
+                    engine.write(0, &mem, addr, count, req)
+                } else {
+                    engine.read(0, &mem, addr, count, req)
+                };
+                let progress = match res {
+                    Err(e) => e.error.progress(),
+                    Ok(FileEngineOk::Submitted) => {
+                        let FileEngine::Async(e) = &mut engine else {
+                            unreachable!()
+                        };
+                        loop {
+                            e.drain(false).unwrap();
+                            if let Some(cqe) = e.pop(&mem).unwrap() {
+                                cqe.result().unwrap_err();
+                                break cqe.progress();
+                            }
+                        }
+                    }
+                    other => panic!("unexpected completion: {other:?}"),
+                };
+                if write {
+                    let mut got = vec![0; chunk as usize];
+                    check.read_exact_at(&mut got, 0).unwrap();
+                    assert!(got.iter().all(|&b| b == 0x5a));
+                    assert_eq!(check.metadata().unwrap().len(), u64::from(chunk));
+                } else {
+                    let mut got = vec![0; count as usize];
+                    mem.read_slice(&mut got, addr).unwrap();
+                    assert!(got[..chunk as usize].iter().all(|&b| b == 0xa5));
+                    assert!(got[chunk as usize..].iter().all(|&b| b == 0x5a));
+                }
+                observed.push((ty, write, progress));
+                assert_eq!(engine.in_flight(), 0);
+            }
+        }
+        assert!(observed.iter().all(|(_, _, n)| *n == chunk), "{observed:?}");
+    }
