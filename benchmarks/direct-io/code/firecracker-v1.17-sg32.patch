+        let mut stream = DescriptorStream::new();
+        assert!(stream.last_byte().is_none());
+        for i in 0..u64::from(FIRECRACKER_MAX_QUEUE_SIZE) {
+            stream.push(GuestAddress(i), 1).unwrap();
+        }
+        let last = GuestAddress(u64::from(FIRECRACKER_MAX_QUEUE_SIZE) - 1);
+        stream.push(GuestAddress(0), 0).unwrap();
+        assert!(matches!(
+            stream.push(GuestAddress(0), 1),
+            Err(VirtioBlockError::DescriptorChainTooShort)
+        ));
+        assert_eq!(stream.last_byte(), Some(last));
+        assert_eq!(stream.remaining, u64::from(FIRECRACKER_MAX_QUEUE_SIZE));
+        let mut visited = 0;
+        stream
+            .take(stream.remaining, |addr, len| {
+                assert_eq!((addr, len), (GuestAddress(visited), 1));
+                visited += 1;
+                Ok(())
+            })
+            .unwrap();
+        assert_eq!(visited, u64::from(FIRECRACKER_MAX_QUEUE_SIZE));
+    }
