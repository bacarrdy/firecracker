+            &iotlb,
+            IOVA,
+            LEN_1 + LEN_2,
+            Permissions::ReadWrite,
+            [
+                MappedRange {
+                    base: PHYS,
+                    length: LEN_1,
+                },
+                MappedRange {
+                    base: PHYS,
+                    length: LEN_2,
+                },
+            ],
+        );
+
+        Ok(())
+    }
