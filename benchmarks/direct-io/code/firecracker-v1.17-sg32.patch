+/// The rate limiter charges one operation per request whatever the number of its segments, and
+/// its data bytes; a multi-segment request deferred behind a read-modify-write is refunded
+/// exactly that (Async: the only engine that defers).
+#[test]
+fn ms_rate_limit_one_op_per_request_and_exact_refund() {
+    let mem = single_region_mem(0x4000000);
+    let mut g = Guest::new(&mem);
+    let f = backing(8 << 20, 0x11);
+    let path = f.as_path().to_str().unwrap().to_string();
+    let mut block = make_block(&path, FileEngineType::Async, true, &mem, &g.vq);
+    // 100 ops and 16 MiB, refilled over 1000 s: no refill during the test.
+    block.rate_limiter = RateLimiter::new(16 << 20, 0, 1_000_000, 100, 0, 1_000_000);
+    let ops0 = block.rate_limiter.ops().unwrap().budget();
+    let bytes0 = block.rate_limiter.bandwidth().unwrap().budget();
+    // Four 16-segment aligned writes of 64 KiB each.
+    for s in 0..4u16 {
+        let segs: Vec<(u64, u32)> = (0..16u64)
+            .map(|i| (Guest::data_addr(s, i * 0x2000), 4096))
+            .collect();
+        put(&mem, &segs, &vec![0x50 + s as u8; 65536]);
+        assert!(g.submit_segs(s, Kind::Write, u64::from(s) * 65536, 65536, &segs));
+    }
+    g.kick(&mut block);
+    let used = wait_used(&mut block, &mut g, 4);
+    once_each(&used, 4);
+    assert_eq!(block.rate_limiter.ops().unwrap().budget(), ops0 - 4);
+    assert_eq!(
+        block.rate_limiter.bandwidth().unwrap().budget(),
+        bytes0 - 4 * 65536
+    );
+    // An RMW of block 64 (charged 512 bytes) in progress; a 3-segment aligned write over block
+    // 64 is deferred behind it and refunded: in the end each request is charged exactly once.
+    let ops1 = block.rate_limiter.ops().unwrap().budget();
+    let bytes1 = block.rate_limiter.bandwidth().unwrap().budget();
+    mem.write_slice(&[0x61; 512], GuestAddress(Guest::data_addr(5, 0)))
+        .unwrap();
+    let segs = vec![
+        (Guest::data_addr(6, 0), 4096),
+        (Guest::data_addr(6, 0x4000), 4096),
+        (Guest::data_addr(6, 0x9000), 8192),
+    ];
+    put(&mem, &segs, &[0x62; 16384]);
+    g.submit(5, Kind::Write, 64 * 4096 + 512, 512, Guest::data_addr(5, 0));
+    assert!(g.submit_segs(6, Kind::Write, 64 * 4096, 16384, &segs));
+    g.kick(&mut block);
+    let used = wait_used(&mut block, &mut g, 2);
+    once_each(&used, 2);
+    ok(&g, &[5, 6]);
+    assert!(
+        block.metrics.direct_bounce_deferred.count() >= 1,
+        "the write was deferred"
+    );
+    assert_eq!(block.rate_limiter.ops().unwrap().budget(), ops1 - 2);
+    assert_eq!(
+        block.rate_limiter.bandwidth().unwrap().budget(),
+        bytes1 - 512 - 16384
+    );
+    // The RMW went first (the write was held behind it): the write's bytes are on top.
+    assert_eq!(file_bytes(&path, 64 * 4096, 16384), vec![0x62; 16384]);
+}
