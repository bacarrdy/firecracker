+/// Snapshot and restore into a new device while a multi-segment RMW is held behind an aligned
+/// multi-segment write, and while a multi-segment bounce over several chunks runs.
+#[test]
+fn ms_snapshot_restore_while_held_and_running() {
+    let mem = single_region_mem(0x4000000);
+    let mut g = Guest::new(&mem);
+    let f = backing(8 << 20, 0x11);
+    let path = f.as_path().to_str().unwrap().to_string();
+    let mut block = make_block(&path, FileEngineType::Async, false, &mem, &g.vq);
+    let w = [
+        (Guest::data_addr(0, 0), 4096),
+        (Guest::data_addr(0, 0x3000), 4096),
+    ];
+    let s = [
+        (Guest::data_addr(1, 0x10), 300),
+        (Guest::data_addr(1, 0x1000), 212),
+    ];
+    put(&mem, &w, &[0xaa; 8192]);
+    put(&mem, &s, &[0x5a; 512]);
+    assert!(g.submit_segs(0, Kind::Write, 4096, 8192, &w));
+    assert!(g.submit_segs(1, Kind::Write, 8192 + 1024, 512, &s));
+    g.kick(&mut block);
+    assert!(block.bounce_hold.is_some());
+    let mut block = save_restore(block, &mem);
+    let used = wait_used(&mut block, &mut g, 2);
+    once_each(&used, 2);
+    ok(&g, &[0, 1]);
+    let mut want = vec![0xaa; 8192];
+    want[4096 + 1024..4096 + 1536].copy_from_slice(&[0x5a; 512]);
+    assert_eq!(file_bytes(&path, 4096, 8192), want);
+
+    // Running: a 3 MiB RMW in four segments, a write of its tail block held behind it.
+    let xsegs: Vec<(u64, u32)> = vec![
+        (Guest::data_addr(2, 0x5), 1 << 20),
+        (Guest::data_addr(2, (1 << 20) + 0x8000), 1 << 20),
+        (Guest::data_addr(3, 0x0), 1 << 20),
+        (Guest::data_addr(3, (1 << 20) + 0x10), 1024),
+    ];
+    let xlen = total(&xsegs);
+    let xdata: Vec<u8> = (0..xlen).map(|i| (i % 249) as u8).collect();
+    put(&mem, &xsegs, &xdata);
+    mem.write_slice(&[0x7e; 4096], GuestAddress(Guest::data_addr(5, 0)))
+        .unwrap();
+    let xoff = (1 << 20) + 512;
+    let tail = (xoff + u64::from(xlen)) / 4096 * 4096;
+    assert!(g.submit_segs(2, Kind::Write, xoff, xlen, &xsegs));
+    g.submit(5, Kind::Write, tail, 4096, Guest::data_addr(5, 0));
+    g.kick(&mut block);
+    assert!(block.disk.file_engine.bounce_in_progress());
+    let mut block = save_restore(block, &mem);
+    let used = wait_used(&mut block, &mut g, 2);
+    once_each(&used, 2);
+    ok(&g, &[2, 5]);
+    let got = file_bytes(&path, xoff, (tail - xoff) as usize);
+    assert!(got[..] == xdata[..(tail - xoff) as usize]);
+    assert_eq!(file_bytes(&path, tail, 4096), vec![0x7e; 4096]);
+    drop(block);
+}
