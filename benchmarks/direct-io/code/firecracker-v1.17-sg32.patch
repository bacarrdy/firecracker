+    // Direct I/O both ways: a multi-segment write goes to the direct file as one vectored
+    // transfer when every segment and the offset are aligned; one unaligned segment sends ALL of
+    // it through the bounce buffer, on the direct file too. Never a mix, never the buffered file.
+    #[test]
+    fn test_vectored_direct_write_never_mixed() {
+        const MEM: usize = 16 * 4096;
+        for engine_type in [FileEngineType::Sync, FileEngineType::Async] {
+            let mem = create_mem_len(MEM);
+            let buffered = TempFile::new().unwrap().into_file();
+            let direct = TempFile::new().unwrap().into_file();
+            buffered.set_len(MEM as u64).unwrap();
+            direct.set_len(MEM as u64).unwrap();
+            let mut buffered_check = buffered.try_clone().unwrap();
+            let mut direct_check = direct.try_clone().unwrap();
+            let mut engine =
+                FileEngine::from_test_backings(buffered, Some(direct), engine_type, false).unwrap();
+            let run = |engine: &mut FileEngine, segs: Vec<DataSegment>, offset: u64, total: u32| {
+                let res = engine.writev(offset, &mem, segs, total, PendingRequest::default());
+                match (engine_type, res) {
+                    (_, Ok(FileEngineOk::Executed(RequestOk { count, bounce, .. }))) => {
+                        assert_eq!(count, total);
+                        bounce
+                    }
+                    (FileEngineType::Async, Ok(FileEngineOk::Submitted)) => {
+                        let done = complete_all(engine, &mem);
+                        assert_eq!(done.len(), 1);
+                        assert_eq!(done[0].result, Ok(total));
+                        done[0].bounce
+                    }
+                    (_, other) => panic!("{other:?}"),
+                }
+            };
+
+            mem.write_slice(&[0x11; 4096], GuestAddress(0x2000))
+                .unwrap();
+            mem.write_slice(&[0x22; 4096], GuestAddress(0x5000))
+                .unwrap();
+            // Aligned: direct file only, as it is.
+            assert_eq!(
+                run(
+                    &mut engine,
+                    vec![(GuestAddress(0x2000), 4096), (GuestAddress(0x5000), 4096)],
+                    0,
+                    8192,
+                ),
+                None
+            );
+            let d = read_file_prefix(&mut direct_check, 8192);
+            assert!(d[..4096].iter().all(|&b| b == 0x11) && d[4096..].iter().all(|&b| b == 0x22));
+
+            // One segment of 512 bytes: the whole request through the bounce buffer, on the
+            // direct file.
+            mem.write_slice(&[0x33; 4096], GuestAddress(0x8000))
+                .unwrap();
+            assert_eq!(
+                run(
+                    &mut engine,
+                    vec![(GuestAddress(0x8000), 4096), (GuestAddress(0x5000), 512)],
+                    8192,
+                    4608,
+                ),
+                Some(Bounce::ReadModifyWrite)
+            );
+            let d = read_file_prefix(&mut direct_check, 8192 + 8192);
+            assert!(d[8192..12288].iter().all(|&x| x == 0x33));
+            assert!(d[12288..12800].iter().all(|&x| x == 0x22));
+            assert!(d[12800..].iter().all(|&x| x == 0));
+            assert!(
+                read_file_prefix(&mut buffered_check, MEM)
+                    .iter()
+                    .all(|&b| b == 0)
+            );
+        }
+    }
