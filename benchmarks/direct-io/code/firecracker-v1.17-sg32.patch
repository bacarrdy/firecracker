+    /// Start serving a guest request through the bounce buffer: queue its first transfer. The
+    /// caller checked `can_proceed(plan.wait())` and the device admitted the request
+    /// (`can_accept`); the request completes through `pop`.
+    pub fn start_bounce(
+        &mut self,
+        plan: BouncePlan,
+        mem: &GuestMemoryMmap,
+        req: PendingRequest,
+    ) -> Result<(), RequestError<AsyncIoError>> {
+        debug_assert!(self.can_proceed(plan.wait()));
+        let dio = self.dio.expect("a bounce implies direct I/O");
+        let filled = bounce_buf(&mut self.bounce_buf, dio)
+            .and_then(|buf| plan.fill(mem, buf.as_mut_slice()))
+            .map_err(AsyncIoError::Bounce);
+        if let Err(error) = filled {
+            return Err(RequestError { req, error });
+        }
+        self.bounce = Some(ActiveBounce {
+            plan,
+            req,
+            mem: mem.clone(),
+            started: Instant::now(),
+        });
+        let operation = self.bounce_operation();
+        match self.ring.push(operation) {
+            Ok(()) => Ok(()),
+            Err((error, _)) => {
+                let bounce = self.bounce.take().expect("set above");
+                Err(RequestError {
+                    req: bounce.req,
+                    error: AsyncIoError::IoUring(error),
+                })
+            }
+        }
+    }
