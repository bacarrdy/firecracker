+/// A 2 MiB write in eight segments of odd lengths (several bounce chunks, partial head and tail
+/// block) with single-segment neighbours in its head and tail blocks and a discard of a
+/// disjoint sector of its tail block, in three orders: every sector exact.
+#[test]
+fn ms_large_bounce_across_chunks_with_neighbours() {
+    for et in [FileEngineType::Async, FileEngineType::Sync] {
+        for order in 0..3 {
+            let mem = single_region_mem(0x4000000);
+            let mut g = Guest::new(&mem);
+            let f = backing(8 << 20, 0x11);
+            let path = f.as_path().to_str().unwrap().to_string();
+            let mut block = make_block(&path, et, true, &mem, &g.vq);
+            let head = 4096u64;
+            let xoff = head + 512;
+            let lens = [700u32, 1 << 20, 4096, 3001, 512 * 1024, 517, 500_000];
+            let mut xsegs = vec![];
+            let mut cursor = Guest::data_addr(1, 0x40);
+            for len in lens {
+                xsegs.push((cursor, len));
+                cursor += u64::from(len) + 0x1003;
+            }
+            let pad = 512 - total(&xsegs) % 512;
+            xsegs.push((cursor, pad + 2048));
+            let xlen = total(&xsegs);
+            assert_eq!(xlen % 512, 0);
+            let xend = xoff + u64::from(xlen);
+            let tail_blk = xend - xend % 4096;
+            // The tail block holds the end of x, the discard d3 right after it and n2 after d3.
+            assert!(!xend.is_multiple_of(4096) && xend % 4096 <= 3072);
+            let xdata: Vec<u8> = (0..xlen).map(|i| (i % 251) as u8 ^ 0x5a).collect();
+            put(&mem, &xsegs, &xdata);
+            mem.write_slice(&[0xe0; 512], GuestAddress(Guest::data_addr(0, 0)))
+                .unwrap();
+            mem.write_slice(&[0xe2; 512], GuestAddress(Guest::data_addr(2, 0)))
+                .unwrap();
+            let n0 = vec![(Guest::data_addr(0, 0), 512u32)];
+            let n2 = vec![(Guest::data_addr(2, 0), 512u32)];
+            let mut reqs: Vec<Req> = vec![
+                (0, Kind::Write, head, 512, n0),
+                (1, Kind::Write, xoff, xlen, xsegs.clone()),
+                (2, Kind::Write, xend + 512, 512, n2),
+                (3, Kind::Discard, xend, 512, vec![]),
+            ];
+            match order {
+                0 => {}
+                1 => reqs.swap(0, 1),
+                _ => reqs.reverse(),
+            }
+            for (s, k, o, l, segs) in &reqs {
+                assert!(g.submit_segs(*s, *k, *o, *l, segs));
+            }
+            g.kick(&mut block);
+            let used = wait_used(&mut block, &mut g, 4);
+            once_each(&used, 4);
+            ok(&g, &[0, 1, 2, 3]);
+            let lo = head;
+            let hi = tail_blk + 4096;
+            let got = file_bytes(&path, lo, (hi - lo) as usize);
+            let mut want = vec![0x11u8; (hi - lo) as usize];
+            want[0..512].copy_from_slice(&[0xe0; 512]);
+            want[512..512 + xlen as usize].copy_from_slice(&xdata);
+            let n2o = (xend + 512 - lo) as usize;
+            want[n2o..n2o + 512].copy_from_slice(&[0xe2; 512]);
+            let d3o = (xend - lo) as usize;
+            want[d3o..d3o + 512].copy_from_slice(&[0; 512]);
+            if got != want {
+                let first = got.iter().zip(&want).position(|(a, b)| a != b).unwrap();
+                panic!(
+                    "{et:?} order {order}: first difference at disk offset {}",
+                    lo + first as u64
+                );
+            }
+            // Read it back through other scattered segments.
+            let rsegs: Vec<(u64, u32)> = vec![
+                (Guest::data_addr(4, 0x11), 333),
+                (Guest::data_addr(4, 0x1000), xlen - 333 - 4096),
+                (Guest::data_addr(5, 0), 4096),
+            ];
+            assert!(g.submit_segs(4, Kind::Read, xoff, xlen, &rsegs));
+            g.kick(&mut block);
+            let used = wait_used(&mut block, &mut g, 1);
+            once_each(&used, 1);
+            ok(&g, &[4]);
+            assert!(
+                gather(&mem, &rsegs) == xdata,
+                "{et:?} order {order}: read back"
+            );
+        }
+    }
+}
