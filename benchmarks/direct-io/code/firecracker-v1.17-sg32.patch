+        assert_eq!(miss_iter.next(), None);
+
+        let mut accf_iter = fails.access_fails.into_iter();
+        for e in expected_access_fails {
+            assert_eq!(accf_iter.next(), Some(e));
+        }
+        assert_eq!(accf_iter.next(), None);
+    }
