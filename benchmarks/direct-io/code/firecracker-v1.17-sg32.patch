+/// Eight multi-segment writes, aligned (vectored on the direct descriptor) and unaligned
+/// (bounced) mixed, when the backing is replaced: every one the device accepted completes once
+/// on the old backing; the ones still waiting in the queue (held behind the one bounce in
+/// progress) run on the new backing; each request's bytes are on exactly one backing.
+#[test]
+fn ms_patch_completes_multi_segment_requests_in_flight() {
+    for et in [FileEngineType::Async, FileEngineType::Sync] {
+        let mem = single_region_mem(0x4000000);
+        let mut g = Guest::new(&mem);
+        let f = backing(1 << 20, 0x11);
+        let h = backing(1 << 20, 0x22);
+        let path = f.as_path().to_str().unwrap().to_string();
+        let path2 = h.as_path().to_str().unwrap().to_string();
+        let mut block = make_block(&path, et, false, &mem, &g.vq);
+        let mut wants = vec![];
+        for s in 0..8u16 {
+            let segs: Vec<(u64, u32)> = if s % 2 == 0 {
+                vec![
+                    (Guest::data_addr(s, 0), 4096),
+                    (Guest::data_addr(s, 0x8000), 8192),
+                    (Guest::data_addr(s, 0x20000), 4096),
+                ]
+            } else {
+                vec![
+                    (Guest::data_addr(s, 0x203), 1000),
+                    (Guest::data_addr(s, 0x8000), 8192),
+                    (Guest::data_addr(s, 0x20011), 7192),
+                ]
+            };
+            let data = vec![0x40 + s as u8; total(&segs) as usize];
+            put(&mem, &segs, &data);
+            let off = u64::from(s) * 65536 + if s % 2 == 0 { 0 } else { 1024 };
+            assert!(g.submit_segs(s, Kind::Write, off, total(&segs), &segs));
+            wants.push((off, data));
+        }
+        g.kick(&mut block);
+        let accepted = usize::from(block.queues[0].next_avail.0);
+        if et == FileEngineType::Async {
+            assert!(accepted >= 3, "requests in flight at the PATCH: {accepted}");
+            assert!(block.disk.file_engine.in_flight() > 0);
+        } else {
+            assert_eq!(accepted, 8);
+        }
+        block.update_disk_image(path2.clone()).unwrap();
+        let used = wait_used(&mut block, &mut g, 8);
+        once_each(&used, 8);
+        ok(&g, &(0..8).collect::<Vec<_>>());
+        for (s, (off, data)) in wants.iter().enumerate() {
+            let (on, other, fill) = if s < accepted {
+                (&path, &path2, 0x22u8)
+            } else {
+                (&path2, &path, 0x11u8)
+            };
+            assert_eq!(&file_bytes(on, *off, data.len()), data, "{et:?} slot {s}");
+            assert_eq!(
+                file_bytes(other, *off, data.len()),
+                vec![fill; data.len()],
+                "{et:?} slot {s} on both backings"
+            );
+        }
+        // Later requests use the new backing.
+        let segs = vec![
+            (Guest::data_addr(9, 0x600), 512),
+            (Guest::data_addr(9, 0x1000), 512),
+        ];
+        put(&mem, &segs, &[0x77; 1024]);
+        assert!(g.submit_segs(9, Kind::Write, 512, 1024, &segs));
+        g.kick(&mut block);
+        let used = wait_used(&mut block, &mut g, 1);
+        once_each(&used, 1);
+        assert_eq!(file_bytes(&path2, 0, 4096)[512..1536], [0x77; 1024]);
+        assert_eq!(file_bytes(&path, 0, 4096)[512..1536], [0x40; 1024]);
+    }
+}
