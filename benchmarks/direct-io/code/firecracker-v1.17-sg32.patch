+
+// Event-driven tests of the direct I/O bounce path (written for the independent verification of
+// 0019, lane verify-dio2, and kept as regression tests), extended to multi-segment requests
+// (scatter/gather): requests with several data descriptors, aligned and unaligned segments
+// mixed, at high queue depth.
+//
+// Every test here drives the device the way the VMM event loop does: the guest side writes
+// descriptors and kicks the queue eventfd; the device side only reacts to events that really
+// fire (the event sources the device registers: the queue eventfd, the io_uring completion
+// eventfd, the rate limiter's timerfd and the retry timerfd). No test calls `drain` to make
+// progress: a request that waits for an event that can no longer happen shows up as a STALL
+// panic.
+#![allow(
+    clippy::undocumented_unsafe_blocks,
+    clippy::cast_possible_truncation,
+    clippy::too_many_arguments,
+    missing_docs
+)]
+
+use std::collections::BTreeMap;
+use std::io::{Read, Seek, SeekFrom, Write};
+use std::os::fd::AsRawFd;
+use std::os::unix::fs::OpenOptionsExt;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::time::{Duration, Instant};
+
+use vmm_sys_util::tempfile::TempFile;
+
+use super::CacheType;
+use super::device::{FileEngineType, VirtioBlock, VirtioBlockConfig};
+use super::io::FileEngine;
+use super::request::RequestHeader;
+use crate::devices::virtio::block::persist::BlockConstructorArgs;
+use crate::devices::virtio::device::VirtioDevice;
+use crate::devices::virtio::generated::virtio_blk::{
+    VIRTIO_BLK_S_IOERR, VIRTIO_BLK_S_OK, VIRTIO_BLK_T_DISCARD, VIRTIO_BLK_T_FLUSH, VIRTIO_BLK_T_IN,
+    VIRTIO_BLK_T_OUT,
+};
+use crate::devices::virtio::queue::{VIRTQ_DESC_F_NEXT, VIRTQ_DESC_F_WRITE};
+use crate::devices::virtio::test_utils::{VirtQueue, default_interrupt};
+use crate::logger::IncMetric;
+use crate::rate_limiter::RateLimiter;
+use crate::snapshot::Persist;
