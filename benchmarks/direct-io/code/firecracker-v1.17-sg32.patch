+            .is_ok());
+
+        if cfg!(target_family = "unix") {
+            assert_eq!(sink, vec![0; size_of::<u32>()]);
+        } else {
+            assert_eq!(sink, vec![0x4d, 0x5a, 0x90, 0x00]);
+        };
+    }
