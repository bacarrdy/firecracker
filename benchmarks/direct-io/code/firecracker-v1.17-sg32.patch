+// ---------------------------------------------------------------------------------------------
+// 9. Multi-segment requests (scatter/gather) on the direct I/O path: the same rules hold for a
+//    request whatever the number of its data segments.
+// ---------------------------------------------------------------------------------------------
+
+/// Write `data` into the guest segments `segs` in order.
+fn put(mem: &GuestMemoryMmap, segs: &[(u64, u32)], data: &[u8]) {
+    let mut at = 0usize;
+    for &(addr, len) in segs {
+        mem.write_slice(&data[at..at + len as usize], GuestAddress(addr))
+            .unwrap();
+        at += len as usize;
+    }
+    assert_eq!(at, data.len());
+}
+
+/// The guest bytes of the segments `segs`, in order.
+fn gather(mem: &GuestMemoryMmap, segs: &[(u64, u32)]) -> Vec<u8> {
+    let mut out = vec![];
+    for &(addr, len) in segs {
+        let mut part = vec![0u8; len as usize];
+        mem.read_slice(&mut part, GuestAddress(addr)).unwrap();
+        out.extend(part);
+    }
+    out
+}
+
+/// A request of a test: slot, kind, offset, length, data segments.
+type Req = (u16, Kind, u64, u32, Vec<(u64, u32)>);
+
+fn total(segs: &[(u64, u32)]) -> u32 {
+    segs.iter().map(|s| s.1).sum()
+}
+
+/// W: an aligned two-segment write of blocks 1-2 (one vectored transfer on the direct
+/// descriptor); S: a three-segment sub-block write into block 2 (odd segment lengths, a
+/// read-modify-write). S waits for W; only W's completion resumes it.
+#[test]
+fn ms_hold_resumed_by_completion_event_only() {
+    for et in [FileEngineType::Async, FileEngineType::Sync] {
+        let mem = single_region_mem(0x1000000);
+        let mut g = Guest::new(&mem);
+        let f = backing(1 << 20, 0x11);
+        let path = f.as_path().to_str().unwrap().to_string();
+        let mut block = make_block(&path, et, false, &mem, &g.vq);
+        let w = [
+            (Guest::data_addr(0, 0), 4096),
+            (Guest::data_addr(0, 0x10000), 4096),
+        ];
+        let s = [
+            (Guest::data_addr(1, 0x7), 100),
+            (Guest::data_addr(1, 0x2003), 412),
+            (Guest::data_addr(1, 0x5000), 512),
+        ];
+        let wdata: Vec<u8> = (0..8192u32).map(|i| (i % 241) as u8).collect();
+        let sdata = vec![0x3cu8; 1024];
+        put(&mem, &w, &wdata);
+        put(&mem, &s, &sdata);
+        assert!(g.submit_segs(0, Kind::Write, 4096, 8192, &w));
+        assert!(g.submit_segs(1, Kind::Write, 8192 + 1024, 1024, &s));
+        g.kick(&mut block);
+        if et == FileEngineType::Async {
+            assert!(block.bounce_hold.is_some(), "S must be held behind W");
+        }
+        let used = wait_used(&mut block, &mut g, 2);
+        once_each(&used, 2);
+        ok(&g, &[0, 1]);
+        let mut want = wdata.clone();
+        want[4096 + 1024..4096 + 2048].copy_from_slice(&sdata);
+        assert_eq!(file_bytes(&path, 4096, 8192), want, "{et:?}");
+        assert!(block.bounce_hold.is_none());
+        assert_eq!(block.metrics.direct_rmw_writes.count(), 1);
+    }
+}
