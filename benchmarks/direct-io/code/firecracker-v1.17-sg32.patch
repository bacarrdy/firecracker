+    /// A transfer of the bounce in progress completed with `res`: queue the next one, or
+    /// return the guest request's completion.
+    fn bounce_step_done(
+        &mut self,
+        res: Result<u32, std::io::Error>,
+    ) -> Result<Option<Cqe<Done>>, AsyncIoError> {
+        let (Some(bounce), Some(buf)) = (self.bounce.as_mut(), self.bounce_buf.as_mut()) else {
+            error!("Direct I/O bounce transfer completed with no bounce in progress");
+            return Ok(None);
+        };
+        let step = bounce.plan.step();
+        if step.write
+            && let Ok(n) = &res
+            && *n as usize <= step.len
+        {
+            bounce.plan.record_write_end(step.dev_off + u64::from(*n));
+        }
+        let more = match res {
+            Ok(n) if n as usize == step.len => bounce.plan.advance(&bounce.mem, buf.as_slice()),
+            Ok(n) => Err(std::io::Error::new(
+                std::io::ErrorKind::UnexpectedEof,
+                format!("short direct transfer: {n} of {} bytes", step.len),
+            )),
+            Err(err) => Err(err),
+        };
+        let more = more.and_then(|more| {
+            if more {
+                bounce.plan.fill(&bounce.mem, buf.as_mut_slice())?;
+            }
+            Ok(more)
+        });
+        match more {
+            Ok(true) => {
+                // The completion path is the only one driving a bounce. A ring that does not
+                // take the transfer now keeps it queued; the device retries (its retry timer).
+                self.continuations.push_back(WrappedRequest::BounceStep);
+                self.submit_pending()?;
+                Ok(None)
+            }
+            Ok(false) => {
+                let sync = self.write_through && bounce.plan.kind() != Bounce::Read;
+                let completed = self.finish_bounce(Ok(()));
+                if sync {
+                    let count = completed.count();
+                    self.queue_write_sync(completed.user_data(), count)?;
+                    Ok(None)
+                } else {
+                    Ok(Some(completed))
+                }
+            }
+            Err(err) => Ok(Some(self.finish_bounce(Err(err)))),
+        }
+    }
