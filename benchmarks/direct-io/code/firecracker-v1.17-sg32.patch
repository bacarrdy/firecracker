+    #[test]
+    fn test_writethrough_negotiation_and_restore() {
+        use crate::devices::virtio::block::persist::BlockConstructorArgs;
+        use crate::snapshot::Persist;
+
+        for engine in [FileEngineType::Sync, FileEngineType::Async] {
+            for (cache_type, ack_flush, stable) in [
+                (CacheType::Unsafe, false, false),
+                (CacheType::Writeback, true, false),
+                (CacheType::Writeback, false, true),
+            ] {
+                let backing = TempFile::new().unwrap();
+                backing.as_file().set_len(64 * 1024).unwrap();
+                let mut config = default_block(engine).config();
+                config.path_on_host = backing.as_path().to_str().unwrap().to_owned();
+                config.cache_type = cache_type;
+                config.rate_limiter = None;
+                let mut block = VirtioBlock::new(config).unwrap();
+                let mem = single_region_mem(0x40000);
+                let vq = VirtQueue::new(GuestAddress(0), &mem, BLOCK_QUEUE_SIZES[0]);
+                block.queues[0] = vq.create_queue();
+                block.acked_features = 1u64 << VIRTIO_F_VERSION_1;
+                if ack_flush {
+                    block.acked_features |= 1u64 << VIRTIO_BLK_F_FLUSH;
+                }
+                block.activate(mem.clone(), default_interrupt()).unwrap();
+
+                // A regular backing can sync a successful logical write.
+                mem.write_slice(&[0x5c; 4096], GuestAddress(0x10000))
+                    .unwrap();
+                put_req(&vq, 0, true, 0, 0x10000, 4096);
+                vq.avail.idx.set(1);
+                simulate_queue_event(&mut block, None);
+                // Snapshot quiescence must finish both the write and its pending fsync.
+                block.prepare_save().unwrap();
+                assert_eq!(vq.used.idx.get(), 1);
+                assert_eq!(u32::from(req_status(&mem, 0)), VIRTIO_BLK_S_OK);
+                assert_eq!(file_bytes(&backing, 0, 4096), vec![0x5c; 4096]);
+
+                let serialized = bitcode::serialize(&block.save()).unwrap();
+                drop(block);
+                let state = bitcode::deserialize(&serialized).unwrap();
+                let mut block =
+                    VirtioBlock::restore(BlockConstructorArgs { mem: mem.clone() }, &state)
+                        .unwrap();
+                block.activate(mem.clone(), default_interrupt()).unwrap();
+                let next = TempFile::new().unwrap();
+                next.as_file().set_len(64 * 1024).unwrap();
+                block
+                    .update_disk_image(next.as_path().to_str().unwrap().to_owned())
+                    .unwrap();
+
+                // /dev/zero accepts data I/O but fsync fails with EINVAL. Force a
+                // 4 KiB DIO geometry to exercise bounced and vectored writes too.
+                let zero = OpenOptions::new()
+                    .read(true)
+                    .write(true)
+                    .open("/dev/zero")
+                    .unwrap();
+                assert_eq!(
+                    zero.sync_all().unwrap_err().raw_os_error(),
+                    Some(libc::EINVAL)
+                );
+                let dio = block_io::direct::DioAlign {
+                    mem: 4096,
+                    offset: 4096,
+                };
+                block
+                    .disk
+                    .file_engine
+                    .update_file_path(zero, Some(dio))
+                    .unwrap();
+                let write_status = if stable {
+                    VIRTIO_BLK_S_IOERR
+                } else {
+                    VIRTIO_BLK_S_OK
+                };
+                // Scalar write, vector write, partial-block RMW, whole-block bounce, read.
+                for (i, write, off, addr, len) in [
+                    (1, true, 0, 0x10000, 4096),
+                    (2, true, 0, 0x10000, 4096),
+                    (3, true, 512, 0x10200, 512),
+                    (4, true, 0, 0x10200, 4096),
+                    (5, false, 0, 0x10000, 4096),
+                ] {
+                    put_req(&vq, i, write, off, addr, len);
+                    if i == 2 {
+                        vq.dtable[7].next.set(24);
+                        vq.dtable[24].set(0x12000, 4096, VIRTQ_DESC_F_NEXT, 8);
+                    }
+                    vq.avail.idx.set(i + 1);
+                    simulate_queue_event(&mut block, None);
+                    complete_until(&mut block, &vq, i + 1);
+                    let expected = if write { write_status } else { VIRTIO_BLK_S_OK };
+                    assert_eq!(u32::from(req_status(&mem, i)), expected, "{engine:?} {i}");
+                }
+                assert!(nothing_in_flight(&block));
+                if stable {
+                    // New negotiations after a device reset can re-enable writeback.
+                    assert!(block.reset());
