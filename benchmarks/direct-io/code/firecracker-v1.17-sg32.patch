+                let mut got = [0;512];
+                m.read_slice(&mut got, GuestAddress(0)).unwrap();
+                assert_eq!(got,[first;512]);
+                m.read_slice(&mut got, GuestAddress(8192)).unwrap();
+                assert_eq!(got,[second;512]);
+                expected[3584..4096].fill(first);
+                expected[4096..4608].fill(second);
+            }
+            let res = engine.flush(PendingRequest::default());
+            assert_eq!(run_result(&mut engine,&m,res),(Ok(0),None));
+            assert_eq!(std::fs::read(&path).unwrap(),expected);
+            let res = engine.discard((3584,1024),PendingRequest::default());
+            let expected_count = match et { FileEngineType::Sync => 1024, FileEngineType::Async => 0 };
+            assert_eq!(run_result(&mut engine,&m,res),(Ok(expected_count),None));
+            expected[3584..4608].fill(0);
