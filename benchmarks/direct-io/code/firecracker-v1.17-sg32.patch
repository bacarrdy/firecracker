+            let mut expected = vec![0x52;8192];
+            for generation in 1..=64u8 {
+                let first = generation;
+                let second = !generation;
+                m.write_slice(&[first;512], GuestAddress(0)).unwrap();
+                m.write_slice(&[second;512], GuestAddress(8192)).unwrap();
+                let res = engine.writev(3584, &m, segs.clone(), 1024, PendingRequest::default());
+                assert_eq!(run_result(&mut engine, &m, res),
+                    (Ok(1024), (expected_align > 512).then_some(Bounce::ReadModifyWrite)));
+                m.write_slice(&[0;512], GuestAddress(0)).unwrap();
+                m.write_slice(&[0;512], GuestAddress(8192)).unwrap();
+                let res = engine.readv(3584, &m, segs.clone(), 1024, PendingRequest::default());
+                assert_eq!(run_result(&mut engine, &m, res),
