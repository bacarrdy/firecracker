+impl<B: BitmapSlice> VolatileMemory for VolatileSlice<'_, B> {
+    type B = B;
+
+    fn len(&self) -> usize {
+        self.size
+    }
+
+    fn get_slice(&self, offset: usize, count: usize) -> Result<VolatileSlice<'_, B>> {
+        self.subslice(offset, count)
+    }
+}
