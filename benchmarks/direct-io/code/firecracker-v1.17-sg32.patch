+/// Moves `iovecs` past the first `done` bytes.
+pub(super) fn advance_iovecs(iovecs: &mut Vec<libc::iovec>, mut done: usize) {
+    let mut drop = 0;
+    for iov in iovecs.iter_mut() {
+        if done < iov.iov_len {
+            iov.iov_base = iov.iov_base.wrapping_add(done);
+            iov.iov_len -= done;
+            break;
+        }
+        done -= iov.iov_len;
+        drop += 1;
+    }
+    iovecs.drain(..drop);
+}
