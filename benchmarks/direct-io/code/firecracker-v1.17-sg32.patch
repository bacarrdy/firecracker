+    /// The operation of the transfer the bounce in progress is at (its bytes, for a write,
+    /// are already in the buffer: `start_bounce`, `bounce_step_done`).
+    fn bounce_operation(&mut self) -> Operation<WrappedRequest> {
+        let (Some(bounce), Some(buf)) = (self.bounce.as_ref(), self.bounce_buf.as_mut()) else {
+            unreachable!("a bounce transfer is queued only while its bounce is in progress");
+        };
+        let step = bounce.plan.step();
+        // The step lies inside the buffer (BouncePlan chunks are at most its length).
+        let addr = buf.as_mut_ptr() as usize + step.buf_off;
+        let len = u32::try_from(step.len).expect("a step fits the bounce buffer");
+        if step.write {
+            Operation::write(0, addr, len, step.dev_off, WrappedRequest::BounceStep)
+        } else {
+            Operation::read(0, addr, len, step.dev_off, WrappedRequest::BounceStep)
+        }
+    }
