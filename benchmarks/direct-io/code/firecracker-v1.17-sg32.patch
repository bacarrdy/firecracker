+/// A 3 MiB misaligned read in five segments whose second chunk reads short (the backing shrank
+/// under the drive): IOERR, the completed guest prefix and status reported, and the next request served.
+#[test]
+fn ms_error_in_middle_chunk_of_read() {
+    for et in [FileEngineType::Async, FileEngineType::Sync] {
+        let mem = single_region_mem(0x4000000);
+        let mut g = Guest::new(&mem);
+        let f = backing(8 << 20, 0x11);
+        let path = f.as_path().to_str().unwrap().to_string();
+        let mut block = make_block(&path, et, false, &mem, &g.vq);
+        f.as_file().set_len((1 << 20) + (512 << 10)).unwrap();
+        let segs: Vec<(u64, u32)> = vec![
+            (Guest::data_addr(0, 0x200), 1 << 20),
+            (Guest::data_addr(0, (1 << 20) + 0x3000), 512),
+            (Guest::data_addr(0, (1 << 20) + 0x5001), (1 << 20) - 512),
+            (Guest::data_addr(1, 0), 4096),
+            (Guest::data_addr(1, 0x2000), (1 << 20) - 4096),
+        ];
+        assert_eq!(total(&segs), 3 << 20);
+        assert!(g.submit_segs(0, Kind::Read, 512, 3 << 20, &segs));
+        g.submit(2, Kind::Read, 1024, 512, Guest::data_addr(2, 0x200));
+        g.kick(&mut block);
+        let used = wait_used(&mut block, &mut g, 2);
+        once_each(&used, 2);
+        assert_eq!(u32::from(g.status(0)), VIRTIO_BLK_S_IOERR, "{et:?}");
+        let len0 = used.iter().find(|u| u.0 == 0).unwrap().1;
+        let copied = (1 << 20) - 512;
+        assert_eq!(len0, copied + 1, "{et:?}: copied guest bytes plus status");
+        let data = gather(&mem, &segs);
+        assert!(data[..copied as usize].iter().all(|&b| b == 0x11));
+        assert!(data[copied as usize..].iter().all(|&b| b == 0));
+        ok(&g, &[2]);
+        assert!(!block.disk.file_engine.bounce_in_progress());
+    }
+}
