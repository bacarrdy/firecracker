+        block.rate_limiter = RateLimiter::new(0, 0, 0, 0, 0, 0);
+        vq.avail.ring[(IO_URING_NUM_ENTRIES + 1) as usize].set(head);
+        vq.avail.idx.set(IO_URING_NUM_ENTRIES + 2);
